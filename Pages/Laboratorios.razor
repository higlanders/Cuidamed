@page "/Laboratorios"
@using System.IO
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Cuidamed.Services
@using Cuidamed.Models
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject CuidanetApiClient CuidanetService

<PageTitle>Cuidanet — Consultas y Laboratorios</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-lab">
            <div class="cn-lab__shell">
                <header class="cn-lab__hero">
                    <div class="cn-lab__hero-glow" aria-hidden="true"></div>
                    <div class="cn-lab__topbar">
                        <button type="button" class="cn-lab__back" @onclick="GoHome" aria-label="Volver al inicio">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        </button>
                        <h1 class="cn-lab__heading">Consultas y Labs</h1>
                        <span class="cn-lab__topbar-spacer" aria-hidden="true"></span>
                    </div>
                    <p class="cn-lab__lead">Sube tu récipe o resultado con la cámara o desde tu dispositivo.</p>
                </header>

                <section class="cn-lab__sheet">
                    <div class="cn-lab__steps" aria-hidden="true">
                        <span class="cn-lab__step is-active"><i class="bi bi-1-circle-fill"></i> Elegir</span>
                        <span class="cn-lab__step-line"></span>
                        <span class="cn-lab__step @(isUploading || ultimoRegistroUploaded != null ? "is-active" : "")">
                            <i class="bi bi-2-circle-fill"></i> Validar
                        </span>
                        <span class="cn-lab__step-line"></span>
                        <span class="cn-lab__step @(ultimoRegistroUploaded != null ? "is-active" : "")">
                            <i class="bi bi-3-circle-fill"></i> Enviar
                        </span>
                    </div>

                    <div class="cn-lab__tabs" role="tablist" aria-label="Origen del documento">
                        <button type="button"
                                role="tab"
                                aria-selected="@(origenSeleccionado == OrigenMedia.Camara)"
                                class="cn-lab__tab @(origenSeleccionado == OrigenMedia.Camara ? "is-active" : "")"
                                @onclick="() => CambiarOrigen(OrigenMedia.Camara)">
                            <i class="bi bi-camera-fill" aria-hidden="true"></i>
                            Cámara
                        </button>
                        <button type="button"
                                role="tab"
                                aria-selected="@(origenSeleccionado == OrigenMedia.Archivo)"
                                class="cn-lab__tab @(origenSeleccionado == OrigenMedia.Archivo ? "is-active" : "")"
                                @onclick="() => CambiarOrigen(OrigenMedia.Archivo)">
                            <i class="bi bi-folder2-open" aria-hidden="true"></i>
                            Archivo
                        </button>
                    </div>

                    @if (origenSeleccionado == OrigenMedia.Camara)
                    {
                        <div class="cn-lab__camera">
                            <div class="cn-lab__viewport @(cameraInitialized ? "is-live" : "")">
                                <video id="webcam" autoplay playsinline muted class="cn-lab__video"></video>
                                <canvas id="captureCanvas" class="cn-lab__canvas"></canvas>
                                @if (!cameraInitialized)
                                {
                                    <div class="cn-lab__viewport-empty">
                                        <i class="bi bi-camera-video" aria-hidden="true"></i>
                                        <p>Enciende la cámara para capturar el documento</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="cn-lab__frame" aria-hidden="true">
                                        <span class="cn-lab__corner cn-lab__corner--tl"></span>
                                        <span class="cn-lab__corner cn-lab__corner--tr"></span>
                                        <span class="cn-lab__corner cn-lab__corner--bl"></span>
                                        <span class="cn-lab__corner cn-lab__corner--br"></span>
                                    </div>
                                    <p class="cn-lab__viewport-hint">Centra el documento dentro del marco</p>
                                }
                            </div>

                            @if (!cameraInitialized)
                            {
                                <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="InicializarCamara" disabled="@isUploading">
                                    <i class="bi bi-camera" aria-hidden="true"></i>
                                    Encender cámara
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="cn-lab__btn cn-lab__btn--primary"
                                        @onclick="TomarYSubirFoto"
                                        disabled="@isUploading">
                                    @if (isUploading)
                                    {
                                        <span class="cn-lab__spinner" aria-hidden="true"></span>
                                        <span>Procesando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-cloud-arrow-up-fill" aria-hidden="true"></i>
                                        <span>Capturar y enviar</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="cn-lab__drop @(isUploading ? "is-busy" : "")">
                            <label class="cn-lab__drop-area">
                                <InputFile OnChange="HandleFileSelected"
                                           class="cn-lab__file-input"
                                           accept="image/png,image/jpeg,application/pdf"
                                           disabled="@isUploading" />
                                <span class="cn-lab__drop-icon" aria-hidden="true">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                </span>
                                <span class="cn-lab__drop-title">Toca para elegir un archivo</span>
                                <span class="cn-lab__drop-hint">JPG, PNG o PDF · máx. 100 MB</span>
                            </label>

                            @if (!string.IsNullOrEmpty(selectedFileName))
                            {
                                <div class="cn-lab__file-chip">
                                    <i class="bi bi-file-earmark-medical" aria-hidden="true"></i>
                                    <span>@selectedFileName</span>
                                </div>
                            }

                            @if (isUploading)
                            {
                                <p class="cn-lab__busy">
                                    <span class="cn-lab__spinner" aria-hidden="true"></span>
                                    <span>Subiendo archivo...</span>
                                </p>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="cn-lab__status @StatusClass" role="status">
                            <i class="bi @StatusIcon" aria-hidden="true"></i>
                            <p>@statusMessage</p>
                        </div>
                    }

                    @if (ultimoRegistroUploaded != null)
                    {
                        <div class="cn-lab__success">
                            <div class="cn-lab__success-badge" aria-hidden="true">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <h2 class="cn-lab__success-title">Documento enviado</h2>
                            <p class="cn-lab__success-lead">Tu archivo quedó registrado en CuidaNet.</p>
                            <dl class="cn-lab__meta">
                                <div>
                                    <dt>ID imagen</dt>
                                    <dd>@ultimoRegistroUploaded.ImagenesId</dd>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(ultimoRegistroUploaded.Periodo))
                                {
                                    <div>
                                        <dt>Periodo</dt>
                                        <dd>@ultimoRegistroUploaded.Periodo</dd>
                                    </div>
                                }
                            </dl>
                            <div class="cn-lab__success-actions">
                                @if (!string.IsNullOrWhiteSpace(ultimoRegistroUploaded.UrlPublica))
                                {
                                    <a class="cn-lab__btn cn-lab__btn--ghost"
                                       href="@ultimoRegistroUploaded.UrlPublica"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                        Ver en servidor
                                    </a>
                                }
                                <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="ResetUpload">
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                    Subir otro
                                </button>
                            </div>
                        </div>
                    }

                    <p class="cn-lab__footnote">
                        Validamos el documento con OCR antes de enviarlo. Usa buena luz y enfoca el texto.
                    </p>
                </section>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private enum OrigenMedia { Camara, Archivo }
    private OrigenMedia origenSeleccionado = OrigenMedia.Camara;

    private bool cameraInitialized;
    private bool isUploading;
    private string statusMessage = string.Empty;
    private string statusTone = "info";
    private string selectedFileName = string.Empty;
    private UploadImagenResponse? ultimoRegistroUploaded;

    private int servicioContextoId = 1024;
    private const long MaxFileSizeBytes = 100 * 1024 * 1024;

    private string StatusClass => statusTone switch
    {
        "success" => "cn-lab__status--success",
        "warning" => "cn-lab__status--warning",
        "danger" => "cn-lab__status--danger",
        _ => "cn-lab__status--info"
    };

    private string StatusIcon => statusTone switch
    {
        "success" => "bi-check-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "danger" => "bi-x-circle-fill",
        _ => "bi-info-circle-fill"
    };

    private void GoHome() => Navigation.NavigateTo("Home");

    private void CambiarOrigen(OrigenMedia nuevoOrigen)
    {
        origenSeleccionado = nuevoOrigen;
        statusMessage = string.Empty;
        selectedFileName = string.Empty;
        ultimoRegistroUploaded = null;
    }

    private void ResetUpload()
    {
        statusMessage = string.Empty;
        selectedFileName = string.Empty;
        ultimoRegistroUploaded = null;
    }

    private async Task InicializarCamara()
    {
        statusMessage = "Solicitando permisos de cámara…";
        statusTone = "info";

        bool resultado = await JS.InvokeAsync<bool>("BlazorCamera.start", "webcam");

        if (resultado)
        {
            cameraInitialized = true;
            statusMessage = "Cámara lista. Posiciona el documento frente al lente.";
            statusTone = "success";
        }
        else
        {
            statusMessage = "No se pudo acceder a la cámara. Revisa los permisos del navegador.";
            statusTone = "danger";
        }
    }

    public class OcrResult
    {
        public bool Exito { get; set; }
        public string TextoExtraido { get; set; } = string.Empty;
        public bool EsDocumentoValido { get; set; }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            selectedFileName = file.Name;

            if (file.Size > MaxFileSizeBytes)
            {
                statusMessage = "El archivo excede el límite permitido de 100 MB.";
                statusTone = "danger";
                return;
            }

            isUploading = true;
            statusMessage = "Analizando contenido del documento (OCR)…";
            statusTone = "info";
            ultimoRegistroUploaded = null;
            StateHasChanged();

            if (file.ContentType.StartsWith("image/"))
            {
                using var memoryStream = new MemoryStream();
                await file.OpenReadStream(MaxFileSizeBytes).CopyToAsync(memoryStream);
                var buffer = memoryStream.ToArray();
                string base64Image = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";

                var resultadoOcr = await JS.InvokeAsync<OcrResult>("BlazorOcr.analizarDocumento", base64Image);

                if (!resultadoOcr.Exito || !resultadoOcr.EsDocumentoValido)
                {
                    statusMessage = "Validación rechazada: el documento no parece un récipe o diagnóstico válido.";
                    statusTone = "warning";
                    return;
                }
            }

            statusMessage = "Enviando archivo a CuidaNet…";
            StateHasChanged();

            using var stream = file.OpenReadStream(MaxFileSizeBytes);
            ultimoRegistroUploaded = await CuidanetService.UploadImagenAsync(
                fileStream: stream,
                fileName: file.Name,
                carpeta: "Servicio",
                servicioId: servicioContextoId
            );

            statusMessage = "Archivo validado y subido correctamente.";
            statusTone = "success";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error al cargar el archivo: {ex.Message}";
            statusTone = "danger";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task TomarYSubirFoto()
    {
        try
        {
            isUploading = true;
            statusMessage = "Procesando captura…";
            statusTone = "info";
            ultimoRegistroUploaded = null;
            StateHasChanged();

            string base64DataUrl = await JS.InvokeAsync<string>("BlazorCamera.capture", "webcam", "captureCanvas");
            if (string.IsNullOrEmpty(base64DataUrl) || !base64DataUrl.Contains(','))
            {
                throw new Exception("La captura falló o el video está vacío.");
            }

            statusMessage = "Validando texto de la captura…";
            StateHasChanged();

            var resultadoOcr = await JS.InvokeAsync<OcrResult>("BlazorOcr.analizarDocumento", base64DataUrl);

            if (!resultadoOcr.Exito || !resultadoOcr.EsDocumentoValido)
            {
                statusMessage = "Validación fallida: enfoca bien el récipe o diagnóstico.";
                statusTone = "warning";
                return;
            }

            string base64Data = base64DataUrl.Split(',')[1];
            byte[] imageBytes = Convert.FromBase64String(base64Data);
            using var memoryStream = new MemoryStream(imageBytes);
            string nombreArchivo = $"Captura_{DateTime.Now:yyyyMMdd_HHmmss}.jpg";

            statusMessage = "Transmitiendo a CuidaNet…";
            StateHasChanged();

            ultimoRegistroUploaded = await CuidanetService.UploadImagenAsync(
                fileStream: memoryStream,
                fileName: nombreArchivo,
                carpeta: "Servicio",
                servicioId: servicioContextoId
            );

            statusMessage = "Captura validada y guardada correctamente.";
            statusTone = "success";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error durante el proceso de cámara: {ex.Message}";
            statusTone = "danger";
        }
        finally
        {
            isUploading = false;
        }
    }
}

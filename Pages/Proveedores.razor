@page "/proveedores"
@using Microsoft.AspNetCore.Components.Authorization
@using Cuidamed.Services
@using Cuidamed.Models
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject CuidanetApiClient CuidanetService

<PageTitle>Cuidanet — Red de Proveedores</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-prov">
            <div class="cn-prov__shell">
                <header class="cn-prov__hero">
                    <div class="cn-prov__hero-glow" aria-hidden="true"></div>
                    <div class="cn-prov__topbar">
                        <button type="button" class="cn-prov__back" @onclick="GoHome" aria-label="Volver al inicio">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        </button>
                        <h1 class="cn-prov__heading">Red de Proveedores</h1>
                        <span class="cn-prov__topbar-spacer" aria-hidden="true"></span>
                    </div>
                    <p class="cn-prov__lead">Encuentra clínicas, laboratorios y farmacias de tu red.</p>
                </header>

                <section class="cn-prov__sheet">
                    <div class="cn-prov__filters-form">
                        <label class="cn-prov__field">
                            <span>Estado</span>
                            <select class="cn-prov__select" value="@filtroEstado" @onchange="OnEstadoChangedAsync">
                                <option value="">Todos</option>
                                @foreach (var e in EstadosDisponibles)
                                {
                                    <option value="@e">@e</option>
                                }
                            </select>
                        </label>
                        <label class="cn-prov__field">
                            <span>Ciudad</span>
                            <select class="cn-prov__select"
                                    value="@filtroCiudad"
                                    @onchange="OnCiudadChanged"
                                    disabled="@(!CiudadesDisponibles.Any())">
                                <option value="">@(string.IsNullOrEmpty(filtroEstado) ? "Todas" : "Todas del estado")</option>
                                @foreach (var c in CiudadesDisponibles)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </label>
                        <label class="cn-prov__field">
                            <span>Tipo</span>
                            <select class="cn-prov__select" value="@filtroTipo" @onchange="OnTipoChanged">
                                <option value="">Todos</option>
                                @foreach (var t in TiposDisponibles)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </label>
                    </div>

                    <div class="cn-prov__search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search"
                               class="cn-prov__search-input"
                               placeholder="Buscar por nombre o dirección"
                               value="@searchQuery"
                               @oninput="OnSearchInput"
                               aria-label="Buscar proveedores" />
                        @if (!string.IsNullOrWhiteSpace(searchQuery))
                        {
                            <button type="button" class="cn-prov__search-clear" @onclick="ClearSearch" aria-label="Limpiar búsqueda">
                                <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                            </button>
                        }
                    </div>

                    @if (isLoading)
                    {
                        <p class="cn-prov__count">Cargando proveedores…</p>
                    }
                    else if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="cn-prov__empty">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            <p>@errorMessage</p>
                            <button type="button" class="cn-prov__empty-btn" @onclick="ReloadAsync">Reintentar</button>
                        </div>
                    }
                    else
                    {
                        <p class="cn-prov__count">
                            @FilteredProveedores.Count() @(FilteredProveedores.Count() == 1 ? "resultado" : "resultados")
                        </p>

                        @if (!FilteredProveedores.Any())
                        {
                            <div class="cn-prov__empty">
                                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                <p>No encontramos proveedores con esos criterios.</p>
                                <button type="button" class="cn-prov__empty-btn" @onclick="ResetFilters">Ver todos</button>
                            </div>
                        }
                        else
                        {
                            <ul class="cn-prov__list">
                                @foreach (var p in FilteredProveedores)
                                {
                                    <li class="cn-prov__card">
                                        <div class="cn-prov__card-icon" aria-hidden="true">
                                            <i class="bi @IconoPorTipo(p.Tipo)"></i>
                                        </div>
                                        <div class="cn-prov__card-body">
                                            <div class="cn-prov__card-top">
                                                <h2 class="cn-prov__card-name">@p.Nombre</h2>
                                                @if (!string.IsNullOrWhiteSpace(p.Tipo))
                                                {
                                                    <span class="cn-prov__badge">@p.Tipo</span>
                                                }
                                            </div>
                                            <p class="cn-prov__card-meta">
                                                <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                                                @FormatUbicacion(p)
                                            </p>
                                            <div class="cn-prov__card-actions">
                                                @if (!string.IsNullOrWhiteSpace(p.Telefono))
                                                {
                                                    <a class="cn-prov__action cn-prov__action--call" href="tel:@DigitsOnly(p.Telefono)">
                                                        <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                                                        Llamar
                                                    </a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(p.ContactoWhatsApp))
                                                {
                                                    <a class="cn-prov__action cn-prov__action--wa"
                                                       href="@WhatsAppUrl(p.ContactoWhatsApp)"
                                                       target="_blank"
                                                       rel="noopener noreferrer">
                                                        <i class="bi bi-whatsapp" aria-hidden="true"></i>
                                                        WhatsApp
                                                    </a>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(p.Direccion))
                                                {
                                                    <a class="cn-prov__action cn-prov__action--map"
                                                       href="@MapUrl(p)"
                                                       target="_blank"
                                                       rel="noopener noreferrer">
                                                        <i class="bi bi-map" aria-hidden="true"></i>
                                                        Ver mapa
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    }
                </section>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private string cedulaUsuario = string.Empty;
    private string searchQuery = string.Empty;
    private string filtroEstado = string.Empty;
    private string filtroCiudad = string.Empty;
    private string filtroTipo = string.Empty;
    private bool isLoading = true;
    private string? errorMessage;

    private List<ProveedorRedDto> todosProveedores = new();

    private IEnumerable<string> EstadosDisponibles =>
        todosProveedores
            .Select(p => p.Estado)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)!;

    private IEnumerable<string> CiudadesDisponibles
    {
        get
        {
            var q = todosProveedores.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(filtroEstado))
            {
                q = q.Where(p => string.Equals(p.Estado, filtroEstado, StringComparison.OrdinalIgnoreCase));
            }

            return q
                .Select(p => p.Ciudad)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)!;
        }
    }

    private IEnumerable<string> TiposDisponibles =>
        todosProveedores
            .Select(p => p.Tipo)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)!;

    private IEnumerable<ProveedorRedDto> FilteredProveedores
    {
        get
        {
            IEnumerable<ProveedorRedDto> q = todosProveedores;

            if (!string.IsNullOrWhiteSpace(filtroEstado))
                q = q.Where(p => string.Equals(p.Estado, filtroEstado, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(filtroCiudad))
                q = q.Where(p => string.Equals(p.Ciudad, filtroCiudad, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(filtroTipo))
                q = q.Where(p => string.Equals(p.Tipo, filtroTipo, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var term = searchQuery.Trim();
                q = q.Where(p =>
                    Contains(p.Nombre, term)
                    || Contains(p.Direccion, term)
                    || Contains(p.Ciudad, term)
                    || Contains(p.Estado, term)
                    || Contains(p.Tipo, term));
            }

            return q;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not { IsAuthenticated: true })
            return;

        cedulaUsuario = user.Identity.Name ?? string.Empty;
        if (string.IsNullOrWhiteSpace(cedulaUsuario))
        {
            errorMessage = "No se encontró la cédula de sesión.";
            isLoading = false;
            return;
        }

        await LoadProveedoresAsync();
    }

    private async Task LoadProveedoresAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            todosProveedores = await CuidanetService.GetRedProveedoresAsync(cedulaUsuario);
        }
        catch (Exception ex)
        {
            todosProveedores = new();
            errorMessage = "No se pudo cargar la red de proveedores. Intenta de nuevo.";
            Console.WriteLine($"Red proveedores: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task OnEstadoChangedAsync(ChangeEventArgs e)
    {
        filtroEstado = e.Value?.ToString() ?? string.Empty;
        // Al cambiar estado, limpiar ciudad si ya no pertenece al estado.
        if (!string.IsNullOrEmpty(filtroCiudad)
            && !CiudadesDisponibles.Contains(filtroCiudad, StringComparer.OrdinalIgnoreCase))
        {
            filtroCiudad = string.Empty;
        }

        return Task.CompletedTask;
    }

    private void OnCiudadChanged(ChangeEventArgs e) =>
        filtroCiudad = e.Value?.ToString() ?? string.Empty;

    private void OnTipoChanged(ChangeEventArgs e) =>
        filtroTipo = e.Value?.ToString() ?? string.Empty;

    private async Task ReloadAsync() => await LoadProveedoresAsync();

    private void ResetFilters()
    {
        searchQuery = string.Empty;
        filtroEstado = string.Empty;
        filtroCiudad = string.Empty;
        filtroTipo = string.Empty;
    }

    private void GoHome() => Navigation.NavigateTo("Home");

    private void OnSearchInput(ChangeEventArgs e) => searchQuery = e.Value?.ToString() ?? string.Empty;

    private void ClearSearch() => searchQuery = string.Empty;

    private static bool Contains(string? source, string query) =>
        !string.IsNullOrEmpty(source) && source.Contains(query, StringComparison.OrdinalIgnoreCase);

    private static string FormatUbicacion(ProveedorRedDto p)
    {
        var parts = new[] { p.Estado, p.Ciudad, p.Direccion }
            .Where(s => !string.IsNullOrWhiteSpace(s));
        return string.Join(" · ", parts);
    }

    private static string IconoPorTipo(string? tipo)
    {
        if (string.IsNullOrWhiteSpace(tipo)) return "bi-geo-alt-fill";
        var t = tipo.Trim().ToLowerInvariant();
        if (t.Contains("lab")) return "bi-eyedropper";
        if (t.Contains("farm")) return "bi-capsule";
        if (t.Contains("odon") || t.Contains("dental")) return "bi-emoji-smile";
        if (t.Contains("clin") || t.Contains("centr") || t.Contains("hosp")) return "bi-hospital";
        return "bi-geo-alt-fill";
    }

    private static string DigitsOnly(string value) =>
        new string(value.Where(char.IsDigit).ToArray());

    private static string WhatsAppUrl(string contacto)
    {
        var digits = DigitsOnly(contacto);
        if (digits.Length == 10 && digits.StartsWith('0'))
            digits = "58" + digits[1..];
        else if (digits.Length == 11 && digits.StartsWith("58") == false && digits.StartsWith('0') == false)
            digits = "58" + digits;
        return $"https://wa.me/{digits}";
    }

    private static string MapUrl(ProveedorRedDto p) =>
        $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString($"{p.Nombre} {p.Direccion} {p.Ciudad}")}";
}

@page "/Proveedores"
@layout FrameWork
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JSRuntime

<div class="container-fluid px-2 py-1">

    <!-- Encabezado de la Sección -->
    <div class="d-flex align-items-center mb-3">
        <span class="fs-4 me-2">🏥</span>
        <div>
            <h5 class="fw-bold text-info-custom mb-0">Red de Proveedores</h5>
            <p class="text-muted small mb-0">Encuentra centros médicos, especialistas y servicios en tu zona.</p>
        </div>
    </div>

    <!-- Filtros de Búsqueda -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-3 bg-white">
        <div class="row g-2">
            <!-- Buscar por Nombre o Especialidad -->
            <div class="col-12">
                <label class="form-label font-montserrat text-muted small fw-bold mb-1">BÚSQUEDA RÁPIDA</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0">🔍</span>
                    <input type="text"
                           class="form-control bg-light border-start-0 font-montserrat"
                           placeholder="Ej. Clínica, Dr. Pérez, Odontología..."
                           @bind="filtroTexto"
                           @bind:event="oninput" />
                </div>
            </div>

            <!-- Selección de Estado / Ciudad -->
            <div class="col-6">
                <label class="form-label font-montserrat text-muted small fw-bold mb-1">UBICACIÓN</label>
                <select class="form-select form-select-sm font-montserrat" @bind="estadoSeleccionado">
                    <option value="">Todas</option>
                    <option value="Caracas">Caracas</option>
                    <option value="Miranda">Miranda</option>
                    <option value="Aragua">Aragua</option>
                    <option value="Zulia">Zulia</option>
                </select>
            </div>

            <!-- Selección de Especialidad -->
            <div class="col-6">
                <label class="form-label font-montserrat text-muted small fw-bold mb-1">ESPECIALIDAD</label>
                <select class="form-select form-select-sm font-montserrat" @bind="especialidadSeleccionada">
                    <option value="">Todas</option>
                    <option value="Medicina General">Medicina General</option>
                    <option value="Pediatría">Pediatría</option>
                    <option value="Odontología">Odontología</option>
                    <option value="Laboratorio">Laboratorio</option>
                    <option value="Oftalmología">Oftalmología</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Toggle de Vista: Lista / Mapa -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="text-muted small font-montserrat">
            Se encontraron <strong class="text-info-custom">@ProveedoresFiltrados.Count()</strong> prestadores
        </span>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button"
                    class="btn @(vistaMapa ? "btn-outline-info" : "btn-info text-white") fw-bold"
                    @onclick="() => ToggleVista(false)">
                📋 Lista
            </button>
            <button type="button"
                    class="btn @(vistaMapa ? "btn-info text-white" : "btn-outline-info") fw-bold"
                    @onclick="() => ToggleVista(true)">
                🗺️ Mapa
            </button>
        </div>
    </div>

    <!-- CONTENIDO: VISTA DE MAPA -->
    @if (vistaMapa)
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
            <div id="mapaProveedores" class="mapa-container position-relative">
                <!-- Capa/Placeholder visual del Mapa -->
                <div class="d-flex flex-column justify-content-center align-items-center h-100 bg-light text-muted p-4 text-center">
                    <span style="font-size: 3rem;">📍</span>
                    <p class="fw-bold mb-1 mt-2 text-dark">Mapa Interactivo</p>
                    <p class="small mb-3">Geolocalización de centros y médicos cercanos.</p>
                    <button class="btn btn-sm btn-info text-white fw-bold px-3 rounded-pill" @onclick="CentrarUbicacion">
                        🎯 Usar mi ubicación actual
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- CONTENIDO: VISTA DE LISTA DE PRESTADORES -->
        <div class="d-flex flex-column gap-2 mb-4">
            @if (ProveedoresFiltrados.Any())
            {
                @foreach (var prov in ProveedoresFiltrados)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white tarjet-proveedor">
                        <div class="d-flex align-items-start gap-3">
                            <!-- Icono o Imagen del Prestador -->
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width: 50px; height: 50px; border: 1px solid #00a4ba;">
                                <span style="font-size: 1.5rem;">@(prov.Tipo == "Clínica" ? "🏥" : "👨‍⚕️")</span>
                            </div>

                            <!-- Información Principal -->
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="fw-bold mb-0 text-dark font-montserrat" style="font-size: 14px;">@prov.Nombre</h6>
                                    <span class="badge bg-light text-info-custom border border-info font-montserrat" style="font-size: 10px;">
                                        @prov.Tipo
                                    </span>
                                </div>

                                <p class="text-info-custom fw-semibold mb-1" style="font-size: 12px;">@prov.Especialidad</p>

                                <p class="text-muted small mb-1 d-flex align-items-center gap-1" style="font-size: 11px;">
                                    <span>📍</span> @prov.Direccion, <strong>@prov.Ciudad</strong>
                                </p>

                                <div class="d-flex align-items-center gap-3 mt-2 pt-2 border-top">
                                    <a href="tel:@prov.Telefono" class="btn btn-sm btn-outline-info rounded-pill py-0 px-2 font-montserrat" style="font-size: 11px;">
                                        📞 @prov.Telefono
                                    </a>
                                    <button class="btn btn-sm btn-info text-white rounded-pill py-0 px-2 font-montserrat ms-auto" style="font-size: 11px;" @onclick="() => VerDetalle(prov)">
                                        Ver Más
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <span style="font-size: 2.5rem;">🔎</span>
                    <p class="text-muted mt-2 mb-0">No se encontraron proveedores con los criterios ingresados.</p>
                </div>
            }
        </div>
    }

</div>

<!-- CSS Estilo Cuidanet -->
<style>
    .font-montserrat {
        font-family: 'Montserrat', sans-serif;
    }

    .text-info-custom {
        color: #00a4ba !important;
    }

    .mapa-container {
        width: 100%;
        height: 350px;
        border-radius: 12px;
    }

    .tarjet-proveedor {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-left: 4px solid #00a4ba !important;
    }

        .tarjet-proveedor:active {
            transform: scale(0.99);
            background-color: #f7f9fa;
        }

    .form-control:focus, .form-select:focus {
        border-color: #00a4ba;
        box-shadow: 0 0 0 0.25rem rgba(0, 164, 186, 0.25);
    }
</style>

@code {
    private bool vistaMapa = false;
    private string filtroTexto = "";
    private string estadoSeleccionado = "";
    private string especialidadSeleccionada = "";

    // Modelo local simplificado para renderizado visual
    private class Proveedor
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Especialidad { get; set; } = "";
        public string Tipo { get; set; } = ""; // Clínica, Médico, Laboratorio
        public string Ciudad { get; set; } = "";
        public string Direccion { get; set; } = "";
        public string Telefono { get; set; } = "";
    }

    private List<Proveedor> listaProveedores = new()
    {
        new Proveedor { Id = 1, Nombre = "Centro Médico Las Mercedes", Especialidad = "Atención Primaria / Urgencias", Tipo = "Clínica", Ciudad = "Caracas", Direccion = "Av. Principal Las Mercedes", Telefono = "0212-9991111" },
        new Proveedor { Id = 2, Nombre = "Dr. Roberto Mendoza", Especialidad = "Pediatría", Tipo = "Médico", Ciudad = "Caracas", Direccion = "Consultorios El Ádila, Piso 3", Telefono = "0414-1234567" },
        new Proveedor { Id = 3, Nombre = "Laboratorio Clínico Cuidamed", Especialidad = "Laboratorio", Tipo = "Laboratorio", Ciudad = "Miranda", Direccion = "CC. Castillejo, Guatire", Telefono = "0212-3445566" },
        new Proveedor { Id = 4, Nombre = "Dra. Elena Gómez", Especialidad = "Oftalmología", Tipo = "Médico", Ciudad = "Aragua", Direccion = "Policlínica Maracay", Telefono = "0424-7654321" }
    };

    private IEnumerable<Proveedor> ProveedoresFiltrados => listaProveedores.Where(p =>
        (string.IsNullOrWhiteSpace(filtroTexto) || p.Nombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) || p.Especialidad.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(estadoSeleccionado) || p.Ciudad.Equals(estadoSeleccionado, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(especialidadSeleccionada) || p.Especialidad.Contains(especialidadSeleccionada, StringComparison.OrdinalIgnoreCase))
    );

    private void ToggleVista(bool mapa)
    {
        vistaMapa = mapa;
    }

    private async Task CentrarUbicacion()
    {
        // Aquí se llamaría a JavaScript interop para obtener la geolocalización
        await JSRuntime.InvokeVoidAsync("alert", "Obteniendo ubicación del dispositivo...");
    }

    private void VerDetalle(Proveedor proveedor)
    {
        // Lógica de navegación o modal para ver detalle
    }
}
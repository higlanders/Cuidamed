@page "/Home"
@using Microsoft.AspNetCore.Components.Authorization
@using Cuidamed.Services
@using Cuidamed.Models
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject CuidanetApiClient CuidanetService

<PageTitle>Cuidanet — Inicio</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-home">
            <div class="cn-home__shell">
                <header class="cn-home__hero">
                    <div class="cn-home__hero-glow" aria-hidden="true"></div>
                    <div class="cn-home__topbar">
                        <button type="button" class="cn-home__menu-btn" @onclick="ToggleSidebar" aria-label="Abrir menú">
                            <i class="bi bi-list" aria-hidden="true"></i>
                            <span>Menú</span>
                        </button>
                        <button type="button" class="cn-home__avatar-btn" @onclick="ToggleSidebar" aria-label="Mi perfil">
                            @if (afiliadoDetalle != null && !string.IsNullOrEmpty(afiliadoDetalle.FotoBase64))
                            {
                                <img src="data:image/jpeg;base64,@afiliadoDetalle.FotoBase64" alt="" />
                            }
                            else
                            {
                                <span aria-hidden="true">@GetInitials(cedulaUsuario)</span>
                            }
                        </button>
                    </div>
                    <img class="cn-home__logo" src="LogoCuidaNet.png" alt="CuidaNet" />
                    <p class="cn-home__slogan">"Cuidarte nos mueve"</p>
                </header>

                <section class="cn-home__sheet">
                    <h1 class="cn-home__title">¿Qué necesitas hoy?</h1>
                    <p class="cn-home__subtitle">Accede a tus servicios de salud en un toque.</p>

                    <nav class="cn-home__grid" aria-label="Servicios">
                        <button type="button" class="cn-home__tile" @onclick='() => NavigateTo("beneficios")'>
                            <span class="cn-home__tile-icon cn-home__tile-icon--blue" aria-hidden="true">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <span class="cn-home__tile-body">
                                <span class="cn-home__tile-label">Coberturas y consumos</span>
                                <span class="cn-home__tile-hint">Consulta tu plan</span>
                            </span>
                            <i class="bi bi-chevron-right cn-home__tile-chevron" aria-hidden="true"></i>
                        </button>

                        <button type="button" class="cn-home__tile cn-home__tile--featured" @onclick='() => NavigateTo("proveedores")'>
                            <span class="cn-home__tile-icon cn-home__tile-icon--teal" aria-hidden="true">
                                <i class="bi bi-geo-alt-fill"></i>
                            </span>
                            <span class="cn-home__tile-body">
                                <span class="cn-home__tile-label">Red de Proveedores</span>
                                <span class="cn-home__tile-hint">Clínicas, labs y más</span>
                            </span>
                            <i class="bi bi-chevron-right cn-home__tile-chevron" aria-hidden="true"></i>
                        </button>

                        <button type="button" class="cn-home__tile" @onclick='() => NavigateTo("citas-aps")'>
                            <span class="cn-home__tile-icon cn-home__tile-icon--orange" aria-hidden="true">
                                <i class="bi bi-calendar2-heart"></i>
                            </span>
                            <span class="cn-home__tile-body">
                                <span class="cn-home__tile-label">Agendar cita APS</span>
                                <span class="cn-home__tile-hint">Atención primaria</span>
                            </span>
                            <i class="bi bi-chevron-right cn-home__tile-chevron" aria-hidden="true"></i>
                        </button>

                        <button type="button" class="cn-home__tile" @onclick='() => NavigateTo("Laboratorios")'>
                            <span class="cn-home__tile-icon cn-home__tile-icon--deep" aria-hidden="true">
                                <i class="bi bi-file-earmark-medical"></i>
                            </span>
                            <span class="cn-home__tile-body">
                                <span class="cn-home__tile-label">Consultas y Laboratorios</span>
                                <span class="cn-home__tile-hint">Cargar documentos</span>
                            </span>
                            <i class="bi bi-chevron-right cn-home__tile-chevron" aria-hidden="true"></i>
                        </button>
                    </nav>
                </section>
            </div>

            <div class="cn-home__overlay @(isSidebarOpen ? "is-open" : "")" @onclick="ToggleSidebar"></div>
            <aside class="cn-home__drawer @(isSidebarOpen ? "is-open" : "")" aria-hidden="@(!isSidebarOpen)">
                <div class="cn-home__drawer-header">
                    <h2>Mi Perfil</h2>
                    <button type="button" class="cn-home__drawer-close" @onclick="ToggleSidebar" aria-label="Cerrar menú">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="cn-home__drawer-body">
                    @if (afiliadoDetalle != null)
                    {
                        <div class="cn-home__profile">
                            @if (!string.IsNullOrEmpty(afiliadoDetalle.FotoBase64))
                            {
                                <img class="cn-home__profile-photo"
                                     src="data:image/jpeg;base64,@afiliadoDetalle.FotoBase64"
                                     alt="Foto del afiliado" />
                            }
                            else
                            {
                                <div class="cn-home__profile-photo cn-home__profile-photo--placeholder" aria-hidden="true">
                                    @GetInitials(cedulaUsuario)
                                </div>
                            }
                            <p class="cn-home__profile-name">Afiliado</p>
                            <p class="cn-home__profile-cedula">Cédula @cedulaUsuario</p>
                        </div>
                    }
                    else if (isLoading)
                    {
                        <div class="cn-home__drawer-loading">
                            <div class="spinner-border spinner-border-sm text-info" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p>Cargando datos del afiliado...</p>
                        </div>
                    }
                    else
                    {
                        <div class="cn-home__profile">
                            <div class="cn-home__profile-photo cn-home__profile-photo--placeholder" aria-hidden="true">
                                @GetInitials(cedulaUsuario)
                            </div>
                            <p class="cn-home__profile-cedula">Cédula @cedulaUsuario</p>
                        </div>
                    }

                    <nav class="cn-home__drawer-nav" aria-label="Accesos rápidos">
                        <button type="button" class="cn-home__drawer-link" @onclick='() => NavigateFromDrawer("proveedores")'>
                            <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                            <span>Red de Proveedores</span>
                        </button>
                        <button type="button" class="cn-home__drawer-link" @onclick='() => NavigateFromDrawer("Laboratorios")'>
                            <i class="bi bi-file-earmark-medical" aria-hidden="true"></i>
                            <span>Consultas y Laboratorios</span>
                        </button>
                        <button type="button" class="cn-home__drawer-link" @onclick='() => NavigateFromDrawer("beneficios")'>
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <span>Coberturas y consumos</span>
                        </button>
                        <button type="button" class="cn-home__drawer-link" @onclick='() => NavigateFromDrawer("citas-aps")'>
                            <i class="bi bi-calendar2-heart" aria-hidden="true"></i>
                            <span>Agendar cita APS</span>
                        </button>
                    </nav>

                    <button type="button" class="cn-home__logout" @onclick="BeginLogOut">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        Salir
                    </button>
                </div>
            </aside>
        </div>
    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isSidebarOpen = false;
    private bool isLoading = true;
    private string cedulaUsuario = string.Empty;
    private BeneficiarioDto? afiliadoDetalle;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            cedulaUsuario = user.Identity.Name ?? string.Empty;

            try
            {
                var resultados = await CuidanetService.GetBeneficiariosAsync(cedula: cedulaUsuario);
                if (resultados != null && resultados.Any())
                {
                    var primerAfiliado = resultados.First();
                    afiliadoDetalle = await CuidanetService.GetBeneficiarioDetalleAsync(primerAfiliado.BeneficiarioId);
                }
            }
            catch (Exception)
            {
                // Silencioso: el home sigue usable sin foto/detalle
            }
            finally
            {
                isLoading = false;
            }
        }
    }

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;

    private void NavigateTo(string page) => Navigation.NavigateTo($"/{page}");

    private void NavigateFromDrawer(string page)
    {
        isSidebarOpen = false;
        NavigateTo(page);
    }

    private static string GetInitials(string cedula)
    {
        if (string.IsNullOrWhiteSpace(cedula) || cedula.Length < 2)
            return "?";
        return cedula[^2..].ToUpperInvariant();
    }

    public async Task BeginLogOut()
    {
        var customAuth = (CustomAuthStateProvider)AuthStateProvider;
        await customAuth.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

@page "/Home"
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Cuidanet.Services
@using Cuidanet.Models
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject CuidanetApiClient CuidanetService
@inject AfiliadoPerfilService PerfilService

<PageTitle>Cuidanet — Inicio</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-home">
            <div class="cn-home__shell">
                <header class="cn-home__hero">
                    <div class="cn-home__topbar">
                        <img class="cn-home__logo" src="LogoCuidaNet.png" alt="CuidaNet" />
                        <button type="button" class="cn-home__avatar-btn" @onclick="ToggleSidebar" aria-label="Mi perfil">
                            @if (afiliadoDetalle != null && !string.IsNullOrEmpty(afiliadoDetalle.FotoBase64))
                            {
                                <img src="data:image/jpeg;base64,@afiliadoDetalle.FotoBase64" alt="" />
                            }
                            else
                            {
                                <span aria-hidden="true">@GetInitials()</span>
                            }
                        </button>
                    </div>
                    <p class="cn-home__hello">@Saludo</p>
                    <p class="cn-home__meta">
                        @if (!string.IsNullOrWhiteSpace(cedulaUsuario))
                        {
                            <span>Cédula @cedulaUsuario</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(nombrePlan))
                        {
                            <span class="cn-home__dot" aria-hidden="true">·</span>
                            <span>@nombrePlan</span>
                        }
                    </p>
                    <p class="cn-home__slogan">Cuidamos tu bienestar</p>
                    <SocialLinks />
                </header>

                <section class="cn-home__sheet">
                    <h1 class="cn-home__title">Servicios</h1>
                    <nav class="cn-home__grid" aria-label="Servicios">
                        @foreach (var modulo in modulosVisibles)
                        {
                            <button type="button"
                                    class="cn-home__tile"
                                    @onclick="() => NavigateTo(modulo.Route)">
                                <span class="cn-home__tile-icon"
                                      style="--cn-icon: url('@modulo.IconPath')"
                                      aria-hidden="true"></span>
                                <span class="cn-home__tile-label">@modulo.Label</span>
                            </button>
                        }
                    </nav>
                </section>
            </div>

            <nav class="cn-home__tabbar" aria-label="Navegación principal">
                <button type="button" class="cn-home__tab is-active" aria-current="page">
                    <i class="bi bi-house" aria-hidden="true"></i>
                    <span>Inicio</span>
                </button>
                <button type="button" class="cn-home__tab" @onclick='() => NavigateTo("notificaciones")'>
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <span>Notificaciones</span>
                </button>
                <button type="button" class="cn-home__tab" @onclick="ToggleSidebar">
                    <i class="bi bi-person" aria-hidden="true"></i>
                    <span>Perfil</span>
                </button>
            </nav>

            <div class="cn-home__overlay @(isSidebarOpen ? "is-open" : "")" @onclick="ToggleSidebar"></div>
            <aside class="cn-home__drawer @(isSidebarOpen ? "is-open" : "")" aria-hidden="@(!isSidebarOpen)">
                <div class="cn-home__drawer-header">
                    <h2>Mi Perfil</h2>
                    <button type="button" class="cn-home__drawer-close" @onclick="ToggleSidebar" aria-label="Cerrar menú">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="cn-home__drawer-body">
                    @if (isLoading)
                    {
                        <div class="cn-home__drawer-loading">
                            <div class="spinner-border spinner-border-sm text-info" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p>Cargando datos del afiliado...</p>
                        </div>
                    }
                    else
                    {
                        <div class="cn-home__profile">
                            @if (afiliadoDetalle != null && !string.IsNullOrEmpty(afiliadoDetalle.FotoBase64))
                            {
                                <img class="cn-home__profile-photo"
                                     src="data:image/jpeg;base64,@afiliadoDetalle.FotoBase64"
                                     alt="Foto del afiliado" />
                            }
                            else
                            {
                                <div class="cn-home__profile-photo cn-home__profile-photo--placeholder" aria-hidden="true">
                                    @GetInitials()
                                </div>
                            }
                            <p class="cn-home__profile-name">@NombreAfiliado</p>
                            @if (!string.IsNullOrWhiteSpace(cedulaUsuario))
                            {
                                <p class="cn-home__profile-cedula">Cédula @cedulaUsuario</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(nombrePlan))
                            {
                                <p class="cn-home__profile-plan">@nombrePlan</p>
                            }
                        </div>
                    }

                    <button type="button" class="cn-home__logout" @onclick="BeginLogOut">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        Salir
                    </button>
                </div>
            </aside>
        </div>
    </Authorized>

    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isSidebarOpen = false;
    private bool isLoading = true;
    private string cedulaUsuario = string.Empty;
    private string nombrePlan = string.Empty;
    private BeneficiarioDto? afiliadoDetalle;
    private CoberturaPlanDto? planActivo;
    private IReadOnlyList<AppModule> modulosVisibles = AppModules.All;

    private string NombreAfiliado
    {
        get
        {
            if (TieneNombreReal(afiliadoDetalle?.Nombre, afiliadoDetalle?.Apellido))
                return afiliadoDetalle!.NombreCompleto;
            if (TieneNombreReal(planActivo?.Nombre, planActivo?.Apellido))
                return planActivo!.NombreCompleto;
            return "Afiliado";
        }
    }

    private string Saludo
    {
        get
        {
            var nombre = PrimerNombre();
            return string.IsNullOrWhiteSpace(nombre) ? "Hola" : $"Hola, {nombre}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            cedulaUsuario = user.Identity.Name ?? string.Empty;

            try
            {
                var resultados = await CuidanetService.GetBeneficiariosAsync(cedula: cedulaUsuario);
                afiliadoDetalle = resultados?.FirstOrDefault();
            }
            catch (Exception)
            {
                // El home sigue usable sin ficha; el nombre sale de Cobertura/plan
            }

            try
            {
                var perfil = await PerfilService.GetAsync();
                nombrePlan = perfil.NombrePlan?.Trim() ?? string.Empty;
                modulosVisibles = AppModules.VisibleFor(perfil.EsLis);
                planActivo = new CoberturaPlanDto
                {
                    Nombre = perfil.Nombre,
                    Apellido = perfil.Apellido,
                    NombrePlan = perfil.NombrePlan,
                    NombreCliente = perfil.NombreCliente,
                    ClienteId = perfil.ClienteId,
                    Cedula = cedulaUsuario
                };

                if (afiliadoDetalle is not null)
                    CompletarNombre(afiliadoDetalle, perfil.Nombre, perfil.Apellido);
            }
            catch (Exception)
            {
                // El home sigue usable sin el nombre del plan
            }
            finally
            {
                isLoading = false;
            }
        }
        else
        {
            isLoading = false;
        }
    }

    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;

    private void NavigateTo(string page) =>
        Navigation.NavigateTo(page.TrimStart('/'));

    private string GetInitials()
    {
        var source = NombreAfiliado;
        if (string.IsNullOrWhiteSpace(source) || source == "Afiliado")
            source = cedulaUsuario;
        if (string.IsNullOrWhiteSpace(source))
            return "?";

        var parts = source.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        if (source.Length >= 2 && source.All(char.IsDigit))
            return source[^2..].ToUpperInvariant();
        return source[..1].ToUpperInvariant();
    }

    private string? PrimerNombre()
    {
        if (!string.IsNullOrWhiteSpace(afiliadoDetalle?.Nombre))
            return afiliadoDetalle.Nombre.Trim();
        if (!string.IsNullOrWhiteSpace(planActivo?.Nombre))
            return planActivo.Nombre.Trim();

        var completo = NombreAfiliado;
        if (string.IsNullOrWhiteSpace(completo) || completo == "Afiliado")
            return null;

        return completo.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];
    }

    private static bool TieneNombreReal(string? nombre, string? apellido) =>
        !string.IsNullOrWhiteSpace(nombre) || !string.IsNullOrWhiteSpace(apellido);

    private static void CompletarNombre(BeneficiarioDto destino, string? nombre, string? apellido)
    {
        if (string.IsNullOrWhiteSpace(destino.Nombre) && !string.IsNullOrWhiteSpace(nombre))
            destino.Nombre = nombre;
        if (string.IsNullOrWhiteSpace(destino.Apellido) && !string.IsNullOrWhiteSpace(apellido))
            destino.Apellido = apellido;
    }

    public async Task BeginLogOut()
    {
        var customAuth = (CustomAuthStateProvider)AuthStateProvider;
        await customAuth.MarkUserAsLoggedOut();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}

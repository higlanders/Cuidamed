@page "/reembolso"
@layout EmptyLayout
@using System.IO
@using System.Net.Http
@using Microsoft.AspNetCore.Components.Authorization
@using Cuidanet.Models
@using Cuidanet.Services
@inject NavigationManager Navigation
@inject AfiliadoPerfilService PerfilService
@inject CuidanetAppSettings AppSettings
@inject CuidanetApiClient CuidanetService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject BrandProfile Brand

<PageTitle>@Brand.Title("Medicamentos")</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (!cargando)
        {
            <div class="cn-lab">
                <div class="cn-lab__shell">
                    <PageHeader Title="@TituloPaso"
                                Lead="@LeadPaso"
                                Back="OnBack">
                        @if (paso == PasoFlujo.Documentos || paso == PasoFlujo.Confirmacion)
                        {
                            @if (!string.IsNullOrWhiteSpace(textoBeneficiarioSeleccionado))
                            {
                                <p class="cn-page__ids">@textoBeneficiarioSeleccionado</p>
                            }
                        }
                    </PageHeader>

                    <section class="cn-lab__sheet">
                        @if (paso == PasoFlujo.Familiar)
                        {
                            @if (!string.IsNullOrEmpty(errorFamiliar))
                            {
                                <div class="cn-lab__status cn-lab__status--danger" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                    <p>@errorFamiliar</p>
                                </div>
                                <div class="cn-lab__btn-row">
                                    <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="CargarGrupoFamiliarAsync">
                                        Reintentar
                                    </button>
                                </div>
                            }
                            else if (grupoFamiliar.Count == 0)
                            {
                                <div class="cn-lab__status cn-lab__status--warning" role="status">
                                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                    <p>No se encontró el grupo familiar. Intenta de nuevo.</p>
                                </div>
                            }
                            else
                            {
                                <p class="cn-lab__footnote" style="margin-top:0;text-align:left;color:var(--cn-muted);">
                                    Elige a quién se le adjuntarán los medicamentos.
                                </p>
                                <div class="cn-lab__familia" role="listbox" aria-label="Grupo familiar">
                                    @foreach (var afiliado in grupoFamiliar)
                                    {
                                        var selected = beneficiarioSeleccionadoId == afiliado.BeneficiarioId;
                                        <button type="button"
                                                role="option"
                                                aria-selected="@selected"
                                                class="cn-lab__familia-item @(selected ? "is-selected" : "")"
                                                @onclick="() => SeleccionarFamiliar(afiliado)">
                                            <span class="cn-lab__familia-avatar" aria-hidden="true">
                                                @GetInitials(afiliado)
                                            </span>
                                            <span class="cn-lab__familia-meta">
                                                <span class="cn-lab__familia-nombre">@afiliado.NombreCompleto</span>
                                                <span class="cn-lab__familia-cedula">Cédula @afiliado.Cedula</span>
                                            </span>
                                            <span class="cn-lab__familia-radio" aria-hidden="true"></span>
                                        </button>
                                    }
                                </div>

                                <div class="cn-lab__btn-row">
                                    <button type="button"
                                            class="cn-lab__btn cn-lab__btn--primary"
                                            disabled="@(beneficiarioSeleccionadoId is not > 0)"
                                            @onclick="ContinuarADocumentos">
                                        Continuar
                                    </button>
                                    <button type="button" class="cn-lab__btn cn-lab__btn--ghost" @onclick="IrMisSolicitudes">
                                        Mis solicitudes
                                    </button>
                                </div>
                            }
                        }
                        else if (paso == PasoFlujo.Documentos)
                        {
                            @if (solicitudAbierta is not null)
                            {
                                <div class="cn-lab__status cn-lab__status--warning" role="status">
                                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                    <p>
                                        Ya tienes la solicitud #@solicitudAbierta.SolicitudId
                                        (@EtiquetaStatus(solicitudAbierta.Status)) del
                                        @solicitudAbierta.FechaCrea.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
                                        Si envías ahora se creará otra solicitud nueva.
                                    </p>
                                </div>
                                <div class="cn-lab__btn-row" style="margin-bottom:1rem;">
                                    <button type="button" class="cn-lab__btn cn-lab__btn--ghost"
                                            @onclick="AbrirSolicitudAbierta">
                                        Abrir solicitud #@solicitudAbierta.SolicitudId
                                    </button>
                                </div>
                            }

                            <div class="cn-lab__anexo-list" aria-label="Documentos anexos">
                                @foreach (var seccion in secciones)
                                {
                                    <div class="cn-lab__anexo">
                                        <div class="cn-lab__anexo-head">
                                            <p class="cn-lab__anexo-title">@seccion.Etiqueta</p>
                                            <span class="cn-lab__anexo-badge">
                                                @(seccion.Archivos.Count == 0 ? "Sin fotos" : $"{seccion.Archivos.Count} foto{(seccion.Archivos.Count == 1 ? "" : "s")}")
                                            </span>
                                        </div>

                                        @if (seccion.Archivos.Count > 0)
                                        {
                                            <div class="cn-lab__thumbs">
                                                @foreach (var archivo in seccion.Archivos)
                                                {
                                                    <div class="cn-lab__thumb">
                                                        @if (!string.IsNullOrWhiteSpace(archivo.PreviewDataUrl)
                                                             && !archivo.PreviewDataUrl.StartsWith("data:application/pdf", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <img src="@archivo.PreviewDataUrl" alt="@archivo.FileName" />
                                                        }
                                                        else
                                                        {
                                                            <span class="cn-lab__thumb-file">
                                                                <i class="bi bi-file-earmark" aria-hidden="true"></i>
                                                                @(archivo.FileName ?? "Archivo")
                                                            </span>
                                                        }
                                                        @if (!ocupado && !solicitudEnviada)
                                                        {
                                                            <button type="button"
                                                                    class="cn-lab__thumb-remove"
                                                                    @onclick="() => QuitarArchivo(seccion, archivo)"
                                                                    aria-label="Quitar @(archivo.FileName ?? seccion.Etiqueta)">
                                                                <i class="bi bi-x" aria-hidden="true"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (seccionCaptura == seccion.Tipo)
                                        {
                                            <div class="cn-lab__capture">
                                                <div class="cn-lab__tabs" role="tablist" aria-label="Origen del documento">
                                                    <button type="button"
                                                            role="tab"
                                                            aria-selected="@(origenMedia == OrigenMedia.Camara)"
                                                            class="cn-lab__tab @(origenMedia == OrigenMedia.Camara ? "is-active" : "")"
                                                            @onclick="() => CambiarOrigen(OrigenMedia.Camara)"
                                                            disabled="@ocupado">
                                                        <i class="bi bi-camera-fill" aria-hidden="true"></i>
                                                        Cámara
                                                    </button>
                                                    <button type="button"
                                                            role="tab"
                                                            aria-selected="@(origenMedia == OrigenMedia.Archivo)"
                                                            class="cn-lab__tab @(origenMedia == OrigenMedia.Archivo ? "is-active" : "")"
                                                            @onclick="() => CambiarOrigen(OrigenMedia.Archivo)"
                                                            disabled="@ocupado">
                                                        <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                                        Archivo
                                                    </button>
                                                </div>

                                                @if (origenMedia == OrigenMedia.Camara)
                                                {
                                                    <div class="cn-lab__camera">
                                                        <div class="cn-lab__viewport @(cameraInitialized ? "is-live" : "")">
                                                            <video id="reembolsoWebcam" autoplay playsinline muted class="cn-lab__video"></video>
                                                            <canvas id="reembolsoCanvas" class="cn-lab__canvas"></canvas>
                                                            @if (!cameraInitialized)
                                                            {
                                                                <div class="cn-lab__viewport-empty">
                                                                    <i class="bi bi-camera-video" aria-hidden="true"></i>
                                                                    <p>Enciende la cámara para capturar el documento</p>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="cn-lab__frame" aria-hidden="true">
                                                                    <span class="cn-lab__corner cn-lab__corner--tl"></span>
                                                                    <span class="cn-lab__corner cn-lab__corner--tr"></span>
                                                                    <span class="cn-lab__corner cn-lab__corner--bl"></span>
                                                                    <span class="cn-lab__corner cn-lab__corner--br"></span>
                                                                </div>
                                                                <p class="cn-lab__viewport-hint">Centra el documento dentro del marco</p>
                                                            }
                                                        </div>

                                                        @if (!cameraInitialized)
                                                        {
                                                            <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="InicializarCamara" disabled="@ocupado">
                                                                <i class="bi bi-camera" aria-hidden="true"></i>
                                                                Encender cámara
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button"
                                                                    class="cn-lab__btn cn-lab__btn--primary"
                                                                    @onclick="() => CapturarFotoAsync(seccion)"
                                                                    disabled="@ocupado">
                                                                @if (capturando)
                                                                {
                                                                    <span class="cn-lab__spinner" aria-hidden="true"></span>
                                                                    <span>Capturando…</span>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-camera-fill" aria-hidden="true"></i>
                                                                    <span>Tomar foto</span>
                                                                }
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="cn-lab__drop @(ocupado ? "is-busy" : "")">
                                                        <label class="cn-lab__drop-area" style="min-height:auto;padding:0.85rem;">
                                                            <InputFile @key="@($"{seccion.Tipo}-{inputFileKey}")"
                                                                       OnChange="e => OnArchivoSelected(e, seccion)"
                                                                       class="cn-lab__file-input"
                                                                       accept="image/png,image/jpeg,application/pdf"
                                                                       disabled="@ocupado" />
                                                            <span class="cn-lab__drop-title" style="font-size:0.85rem;">Toca para elegir archivo</span>
                                                            <span class="cn-lab__drop-hint">JPG, PNG o PDF · máx. @AppSettings.MaxUploadMb MB</span>
                                                        </label>
                                                    </div>
                                                }

                                                <button type="button"
                                                        class="cn-lab__btn cn-lab__btn--ghost"
                                                        style="margin-top:0.45rem;"
                                                        @onclick="CerrarCaptura"
                                                        disabled="@ocupado">
                                                    Cerrar captura
                                                </button>
                                            </div>
                                        }
                                        else if (!ocupado && !solicitudEnviada && seccion.Archivos.Count < MaxFotosPorSeccion)
                                        {
                                            <button type="button"
                                                    class="cn-lab__btn cn-lab__btn--outline cn-lab__btn--sm"
                                                    style="width:100%;margin-top:0.35rem;"
                                                    @onclick="() => AbrirCaptura(seccion)">
                                                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                                Agregar foto
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="cn-lab__field">
                                <label class="cn-lab__label" for="comentario">Comentario (opcional)</label>
                                <textarea id="comentario"
                                          class="cn-lab__input"
                                          rows="3"
                                          maxlength="1000"
                                          @bind="comentario"
                                          @bind:event="oninput"
                                          disabled="@ocupado"
                                          placeholder="Ej. urgencia, farmacia preferida, observaciones…"></textarea>
                            </div>
                        }
                        else if (paso == PasoFlujo.Confirmacion)
                        {
                            <div class="cn-lab__status cn-lab__status--info" role="status">
                                <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                                <p>Al confirmar se crea una <strong>solicitud nueva</strong> para @textoBeneficiarioSeleccionado. Revisa que cada archivo esté en el casillero correcto.</p>
                            </div>
                            <div class="cn-lab__anexo-list" aria-label="Resumen de documentos">
                                @foreach (var seccion in secciones.Where(s => s.TieneArchivos))
                                {
                                    <div class="cn-lab__anexo">
                                        <div class="cn-lab__anexo-head">
                                            <p class="cn-lab__anexo-title">@seccion.Etiqueta</p>
                                            <span class="cn-lab__anexo-badge">@seccion.Archivos.Count foto(s)</span>
                                        </div>
                                        <div class="cn-lab__thumbs">
                                            @foreach (var archivo in seccion.Archivos)
                                            {
                                                <div class="cn-lab__thumb">
                                                    @if (!string.IsNullOrWhiteSpace(archivo.PreviewDataUrl)
                                                         && !archivo.PreviewDataUrl.StartsWith("data:application/pdf", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <img src="@archivo.PreviewDataUrl" alt="@archivo.FileName" />
                                                    }
                                                    else
                                                    {
                                                        <span class="cn-lab__thumb-file">@(archivo.FileName ?? "Archivo")</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(comentario))
                            {
                                <div class="cn-lab__field">
                                    <p class="cn-lab__label">Comentario</p>
                                    <p>@comentario</p>
                                </div>
                            }
                        }

                        @if (!string.IsNullOrEmpty(statusMessage) && paso != PasoFlujo.Familiar)
                        {
                            <div class="cn-lab__status @StatusClass" role="status">
                                <i class="bi @StatusIcon" aria-hidden="true"></i>
                                <p>@statusMessage</p>
                            </div>
                        }

                        @if (paso == PasoFlujo.Documentos)
                        {
                            <div class="cn-lab__btn-row">
                                <button type="button"
                                        class="cn-lab__btn cn-lab__btn--primary"
                                        disabled="@(ocupado || !PuedeEnviar || solicitudEnviada)"
                                        @onclick="IrAConfirmacion">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                    <span>Revisar y enviar</span>
                                </button>
                            </div>
                        }
                        else if (paso == PasoFlujo.Confirmacion)
                        {
                            <div class="cn-lab__btn-row">
                                <button type="button" class="cn-lab__btn" disabled="@ocupado" @onclick="VolverADocumentos">
                                    Corregir
                                </button>
                                <button type="button"
                                        class="cn-lab__btn cn-lab__btn--primary"
                                        disabled="@(ocupado || solicitudEnviada)"
                                        @onclick="EnviarSolicitudAsync">
                                    @if (subiendo)
                                    {
                                        <span class="cn-lab__spinner" aria-hidden="true"></span>
                                        <span>Enviando…</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-cloud-arrow-up-fill" aria-hidden="true"></i>
                                        <span>@(HayPendientesRegistro ? "Reintentar envío" : "Confirmar solicitud nueva")</span>
                                    }
                                </button>
                            </div>
                        }
                    </section>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private enum PasoFlujo { Familiar, Documentos, Confirmacion }
    private enum OrigenMedia { Camara, Archivo }

    private const int MaxFotosPorSeccion = 5;
    private const string Carpeta = "Reembolsos";
    private const string Campo = "ReembolsoApp";

    private PasoFlujo paso = PasoFlujo.Familiar;
    private OrigenMedia origenMedia = OrigenMedia.Camara;

    private bool cargando = true;
    private bool subiendo;
    private bool capturando;
    private bool cameraInitialized;
    private bool solicitudEnviada;
    private bool ocupado => subiendo || capturando;

    private string comentario = string.Empty;
    private string statusMessage = string.Empty;
    private string statusTone = "info";
    private string errorFamiliar = string.Empty;
    private string textoBeneficiarioSeleccionado = string.Empty;
    private string? seccionCaptura;
    private int inputFileKey;
    private int? beneficiarioSeleccionadoId;

    private List<BeneficiarioDto> grupoFamiliar = [];
    private ReembolsoSolicitudListaDto? solicitudAbierta;

    private readonly List<ReembolsoSeccionVm> secciones =
    [
        new() { Tipo = "cedula", Etiqueta = "Cédula" },
        new() { Tipo = "recipe", Etiqueta = "Récipe médico" },
        new() { Tipo = "indicaciones", Etiqueta = "Indicaciones" },
        new() { Tipo = "informe", Etiqueta = "Informe médico" },
    ];

    private long MaxFileSizeBytes => AppSettings.MaxUploadBytes;

    private IEnumerable<ReembolsoAnexoVm> TodosLosArchivos =>
        secciones.SelectMany(s => s.Archivos);

    private bool HayDocumentosLocales => TodosLosArchivos.Any(a => a.Bytes is { Length: > 0 });
    private bool HayPendientesRegistro =>
        !solicitudEnviada && TodosLosArchivos.Any(a => a.Upload is not null)
        && TodosLosArchivos.All(a => a.Upload is not null || a.Bytes is not { Length: > 0 });
    private bool PuedeEnviar => HayDocumentosLocales || HayPendientesRegistro;

    private string TituloPaso => paso switch
    {
        PasoFlujo.Familiar => "¿Para quién es?",
        PasoFlujo.Confirmacion => "Confirmar solicitud",
        _ => "Solicitud de medicamentos"
    };

    private string LeadPaso => paso switch
    {
        PasoFlujo.Familiar => "Selecciona un integrante del grupo familiar.",
        PasoFlujo.Confirmacion => "Confirma que cada documento está en el casillero correcto antes de enviar.",
        _ => "Adjunta cédula, récipe, indicaciones e informe. Puedes agregar varias fotos por sección."
    };

    private string StatusClass => statusTone switch
    {
        "success" => "cn-lab__status--success",
        "warning" => "cn-lab__status--warning",
        "danger" => "cn-lab__status--danger",
        _ => "cn-lab__status--info"
    };

    private string StatusIcon => statusTone switch
    {
        "success" => "bi-check-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "danger" => "bi-x-circle-fill",
        _ => "bi-info-circle-fill"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarGrupoFamiliarAsync();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarGrupoFamiliarAsync()
    {
        errorFamiliar = string.Empty;
        grupoFamiliar = [];
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var cedulaSesion = auth.User.Identity?.Name?.Trim() ?? string.Empty;
            var perfil = await PerfilService.GetAsync();

            List<BeneficiarioDto>? grupo = null;
            if (!string.IsNullOrWhiteSpace(cedulaSesion))
            {
                var porCedula = await CuidanetService.GetBeneficiariosAsync(cedula: cedulaSesion);
                var primero = porCedula?.FirstOrDefault();
                if (primero is not null)
                    grupo = await CuidanetService.GetBeneficiariosAsync(titularId: primero.TitularId);
            }

            if ((grupo is null || grupo.Count == 0) && perfil.BeneficiarioId is > 0)
            {
                var detalle = await CuidanetService.GetBeneficiarioDetalleAsync(perfil.BeneficiarioId.Value);
                if (detalle is not null)
                    grupo = await CuidanetService.GetBeneficiariosAsync(titularId: detalle.TitularId);
            }

            grupoFamiliar = (grupo ?? [])
                .OrderBy(b => b.BeneficiarioId == b.TitularId ? 0 : 1)
                .ThenBy(b => b.NombreCompleto, StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (grupoFamiliar.Count == 0)
                errorFamiliar = "No se pudo cargar el grupo familiar.";
            else if (beneficiarioSeleccionadoId is null
                     && perfil.BeneficiarioId is > 0
                     && grupoFamiliar.Any(b => b.BeneficiarioId == perfil.BeneficiarioId))
            {
                var actual = grupoFamiliar.First(b => b.BeneficiarioId == perfil.BeneficiarioId.Value);
                SeleccionarFamiliar(actual);
            }
        }
        catch (Exception)
        {
            errorFamiliar = "No se pudo cargar el grupo familiar. Intenta de nuevo.";
        }
    }

    private void SeleccionarFamiliar(BeneficiarioDto afiliado)
    {
        beneficiarioSeleccionadoId = afiliado.BeneficiarioId;
        textoBeneficiarioSeleccionado = $"{afiliado.NombreCompleto} · C.I. {afiliado.Cedula}";
    }

    private async Task ContinuarADocumentos()
    {
        if (beneficiarioSeleccionadoId is not > 0)
        {
            SetStatus("Selecciona un integrante del grupo familiar.", "warning");
            return;
        }

        await DetenerCamaraAsync();
        seccionCaptura = null;
        paso = PasoFlujo.Documentos;
        statusMessage = string.Empty;
        await CargarSolicitudAbiertaAsync(beneficiarioSeleccionadoId.Value);
    }

    private async Task CargarSolicitudAbiertaAsync(int beneficiarioId)
    {
        solicitudAbierta = null;
        try
        {
            var lista = await CuidanetService.GetReembolsoSolicitudesAsync(beneficiarioId);
            solicitudAbierta = lista.FirstOrDefault(s =>
                !string.Equals(s.Status, "Anulado", StringComparison.OrdinalIgnoreCase)
                && (string.Equals(s.Status, "Pendiente", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(s.Status, "Procesando", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(s.Status, "Error", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(s.Status, "Listo", StringComparison.OrdinalIgnoreCase)));
        }
        catch
        {
            // Sin listado no bloqueamos el alta.
        }
    }

    private async Task OnBack()
    {
        if (paso == PasoFlujo.Confirmacion)
        {
            VolverADocumentos();
            return;
        }

        if (paso == PasoFlujo.Documentos)
        {
            await DetenerCamaraAsync();
            seccionCaptura = null;
            paso = PasoFlujo.Familiar;
            statusMessage = string.Empty;
            return;
        }

        Navigation.NavigateTo("Home");
    }

    private void VolverADocumentos()
    {
        paso = PasoFlujo.Documentos;
        SetStatus("Puedes corregir o agregar fotos.", "info");
    }

    private void GoHome() => Navigation.NavigateTo("Home");
    private void IrMisSolicitudes() => Navigation.NavigateTo("mis-solicitudes");
    private void AbrirSolicitudAbierta()
    {
        if (solicitudAbierta is not null)
            Navigation.NavigateTo($"tratamiento/{solicitudAbierta.SolicitudId}");
    }

    private async Task AbrirCaptura(ReembolsoSeccionVm seccion)
    {
        if (seccion.Archivos.Count >= MaxFotosPorSeccion)
        {
            SetStatus($"Máximo {MaxFotosPorSeccion} fotos en «{seccion.Etiqueta}».", "warning");
            return;
        }

        await DetenerCamaraAsync();
        seccionCaptura = seccion.Tipo;
        origenMedia = OrigenMedia.Camara;
        inputFileKey++;
    }

    private async Task CerrarCaptura()
    {
        await DetenerCamaraAsync();
        seccionCaptura = null;
    }

    private async Task CambiarOrigen(OrigenMedia nuevo)
    {
        if (nuevo == OrigenMedia.Archivo)
            await DetenerCamaraAsync();
        origenMedia = nuevo;
        inputFileKey++;
    }

    private async Task InicializarCamara()
    {
        SetStatus("Solicitando permisos de cámara…", "info");
        var ok = await JS.InvokeAsync<bool>("BlazorCamera.start", "reembolsoWebcam");
        if (ok)
        {
            cameraInitialized = true;
            SetStatus("Cámara lista. Posiciona el documento frente al lente.", "success");
        }
        else
        {
            cameraInitialized = false;
            SetStatus("No se pudo acceder a la cámara. Revisa los permisos o usa Archivo.", "danger");
        }
    }

    private async Task DetenerCamaraAsync()
    {
        if (!cameraInitialized) return;
        try
        {
            await JS.InvokeVoidAsync("BlazorCamera.stop", "reembolsoWebcam");
        }
        catch
        {
            // Best-effort stop.
        }
        cameraInitialized = false;
    }

    private async Task CapturarFotoAsync(ReembolsoSeccionVm seccion)
    {
        if (seccion.Archivos.Count >= MaxFotosPorSeccion)
        {
            SetStatus($"Máximo {MaxFotosPorSeccion} fotos en «{seccion.Etiqueta}».", "warning");
            return;
        }

        try
        {
            capturando = true;
            SetStatus("Procesando captura…", "info");
            StateHasChanged();

            var base64DataUrl = await JS.InvokeAsync<string>("BlazorCamera.capture", "reembolsoWebcam", "reembolsoCanvas");
            if (string.IsNullOrEmpty(base64DataUrl) || !base64DataUrl.Contains(','))
            {
                SetStatus("La captura falló o el video está vacío.", "danger");
                return;
            }

            var base64Data = base64DataUrl.Split(',')[1];
            var imageBytes = Convert.FromBase64String(base64Data);
            var nombreArchivo = $"Captura_{DateTime.Now:yyyyMMdd_HHmmss}.jpg";

            if (!CameraCapturePdf.TryFromJpeg(
                    imageBytes,
                    nombreArchivo,
                    MaxFileSizeBytes,
                    AppSettings.MaxUploadMb,
                    out var pdfName,
                    out var pdfBytes,
                    out var validationError))
            {
                SetStatus(validationError ?? "La captura no es una imagen válida.", "danger");
                return;
            }

            AgregarArchivo(seccion, pdfName, pdfBytes, "application/pdf", base64DataUrl);
            SetStatus($"Foto agregada a «{seccion.Etiqueta}».", "success");
        }
        catch (Exception)
        {
            SetStatus("No se pudo capturar la foto. Intenta de nuevo.", "danger");
        }
        finally
        {
            capturando = false;
        }
    }

    private async Task OnArchivoSelected(InputFileChangeEventArgs e, ReembolsoSeccionVm seccion)
    {
        if (seccion.Archivos.Count >= MaxFotosPorSeccion)
        {
            SetStatus($"Máximo {MaxFotosPorSeccion} fotos en «{seccion.Etiqueta}».", "warning");
            return;
        }

        try
        {
            var file = e.File;
            if (file is null) return;

            if (file.Size > MaxFileSizeBytes)
            {
                SetStatus($"El archivo excede el límite de {AppSettings.MaxUploadMb} MB.", "danger");
                return;
            }

            await using var stream = file.OpenReadStream(MaxFileSizeBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var bytes = memory.ToArray();

            if (!UploadFileGuard.TryValidate(
                    file.Name,
                    bytes,
                    MaxFileSizeBytes,
                    AppSettings.MaxUploadMb,
                    out var safeName,
                    out var validationError))
            {
                SetStatus(validationError ?? "Archivo no permitido.", "danger");
                return;
            }

            AgregarArchivo(seccion, safeName, bytes, GuessMime(safeName), BuildDataUrl(safeName, bytes));
            inputFileKey++;
            SetStatus($"Archivo «{safeName}» listo en «{seccion.Etiqueta}».", "success");
        }
        catch (Exception)
        {
            SetStatus("No se pudo leer el archivo. Intenta de nuevo.", "danger");
        }
    }

    private void AgregarArchivo(
        ReembolsoSeccionVm seccion,
        string fileName,
        byte[] bytes,
        string contentType,
        string? previewDataUrl)
    {
        var anexo = seccion.CrearArchivo();
        anexo.FileName = fileName;
        anexo.Bytes = bytes;
        anexo.ContentType = contentType;
        anexo.PreviewDataUrl = previewDataUrl;
        anexo.Upload = null;
        seccion.Archivos.Add(anexo);
        solicitudEnviada = false;
    }

    private void QuitarArchivo(ReembolsoSeccionVm seccion, ReembolsoAnexoVm archivo)
    {
        seccion.Archivos.Remove(archivo);
        solicitudEnviada = false;
        SetStatus("Archivo quitado.", "info");
    }

    private void IrAConfirmacion()
    {
        if (!PuedeEnviar)
        {
            SetStatus("Adjunta al menos una foto o archivo para continuar.", "warning");
            return;
        }

        _ = DetenerCamaraAsync();
        seccionCaptura = null;
        paso = PasoFlujo.Confirmacion;
        SetStatus("Revisa el resumen. Si algo está mal, toca Corregir.", "info");
    }

    private async Task EnviarSolicitudAsync()
    {
        var pendientes = TodosLosArchivos.Where(a => a.Bytes is { Length: > 0 } && a.Upload is null).ToList();
        var yaSubidos = TodosLosArchivos.Where(a => a.Upload is not null).ToList();

        if (pendientes.Count == 0 && yaSubidos.Count == 0)
        {
            SetStatus("Adjunta al menos un documento para subir.", "warning");
            return;
        }

        if (beneficiarioSeleccionadoId is not > 0)
        {
            SetStatus("Selecciona un integrante del grupo familiar.", "warning");
            paso = PasoFlujo.Familiar;
            return;
        }

        try
        {
            subiendo = true;
            SetStatus(pendientes.Count > 0 ? "Subiendo documentos…" : "Registrando solicitud nueva…", "info");
            StateHasChanged();

            var comentarioTrim = string.IsNullOrWhiteSpace(comentario) ? null : comentario.Trim();
            if (comentarioTrim is { Length: > 1000 })
                comentarioTrim = comentarioTrim[..1000];

            foreach (var anexo in pendientes)
            {
                try
                {
                    using var memory = new MemoryStream(anexo.Bytes!);
                    anexo.Upload = await CuidanetService.UploadImagenAsync(
                        fileStream: memory,
                        fileName: anexo.FileName!,
                        carpeta: Carpeta,
                        fuente: AppSettings.ImagenFuente,
                        campo: Campo,
                        beneficiarioId: beneficiarioSeleccionadoId,
                        observaciones: comentarioTrim);
                }
                catch (HttpRequestException ex)
                {
                    SetStatus(
                        string.IsNullOrWhiteSpace(ex.Message)
                            ? $"No se pudo subir «{anexo.Etiqueta}». Puedes quitarlo o reintentar."
                            : $"{ex.Message} («{anexo.Etiqueta}»). Puedes quitarlo o reintentar.",
                        "danger");
                    return;
                }
            }

            var imagenIds = TodosLosArchivos
                .Where(a => a.Upload is not null)
                .Select(a => new ReembolsoSolicitudImagenDto
                {
                    ImagenesId = a.Upload!.ImagenesId,
                    TipoAnexo = a.Tipo
                })
                .ToList();

            if (imagenIds.Count == 0)
            {
                SetStatus("No hay documentos válidos para registrar. Adjunta al menos uno.", "warning");
                return;
            }

            var registro = await CuidanetService.RegistrarReembolsoSolicitudAsync(
                new ReembolsoSolicitudRequest
                {
                    Comentario = comentarioTrim,
                    BeneficiarioId = beneficiarioSeleccionadoId,
                    Imagenes = imagenIds
                });

            solicitudEnviada = true;
            var tid = registro?.TratamientoId is > 0 ? $" (tratamiento n.º {registro.TratamientoId})" : "";
            SetStatus(
                $"Solicitud nueva #{registro?.SolicitudId} registrada{tid}. Ya puedes revisar los adjuntos en el detalle.",
                "success");

            if (registro?.SolicitudId is > 0)
                Navigation.NavigateTo($"tratamiento/{registro.SolicitudId}");
        }
        catch (HttpRequestException ex)
        {
            SetStatus(
                string.IsNullOrWhiteSpace(ex.Message)
                    ? "No se pudo completar el envío. Puedes reintentar sin volver a elegir los archivos."
                    : $"{ex.Message} Puedes reintentar sin volver a elegir los archivos.",
                "danger");
        }
        catch (Exception)
        {
            SetStatus("No se pudo completar el envío. Puedes reintentar o quitar un archivo y subir otro.", "danger");
        }
        finally
        {
            subiendo = false;
        }
    }

    private void SetStatus(string message, string tone)
    {
        statusMessage = message;
        statusTone = tone;
    }

    private static string GetInitials(BeneficiarioDto b)
    {
        var n = (b.Nombre ?? string.Empty).Trim();
        var a = (b.Apellido ?? string.Empty).Trim();
        if (n.Length > 0 && a.Length > 0)
            return $"{char.ToUpperInvariant(n[0])}{char.ToUpperInvariant(a[0])}";
        var digits = new string((b.Cedula ?? string.Empty).Where(char.IsDigit).ToArray());
        return digits.Length >= 2 ? digits[^2..] : "?";
    }

    private static string EtiquetaStatus(string? status) => status switch
    {
        "Pendiente" => "en cola",
        "Procesando" => "analizando",
        "Listo" => "procesada",
        "Error" => "con error",
        _ => status ?? "activa"
    };

    private static string GuessMime(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".pdf" => "application/pdf",
            _ => "application/octet-stream"
        };
    }

    private static string? BuildDataUrl(string fileName, byte[] bytes)
    {
        var mime = GuessMime(fileName);
        if (mime == "application/octet-stream") return null;
        if (bytes.Length > 2 * 1024 * 1024)
            return null;
        return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
    }
}

@page "/telemedicina"
@page "/amd"
@layout EmptyLayout
@using Cuidanet.Models
@using Cuidanet.Services
@inject NavigationManager Navigation
@inject AfiliadoPerfilService PerfilService
@inject CuidanetAppSettings AppSettings
@inject IJSRuntime JS

<PageTitle>Cuidanet — @Titulo</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-svc">
            <div class="cn-svc__shell">
                <header class="cn-svc__hero">
                    <button type="button" class="cn-svc__back" @onclick="GoHome" aria-label="Volver al inicio">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    </button>
                    <h1 class="cn-svc__heading">@Titulo</h1>
                    <span class="cn-svc__spacer" aria-hidden="true"></span>
                </header>

                <section class="cn-svc__sheet">
                    @if (cargando)
                    {
                        <p class="cn-svc__muted">Cargando…</p>
                    }
                    else if (esLis)
                    {
                        <p class="cn-svc__lead">Este servicio lo presta Venemergencia.</p>
                        <p class="cn-svc__muted">Te llevamos a su sitio para continuar la atención.</p>
                        @if (AppSettings.EsUrlVenemergenciaValida)
                        {
                            <a class="cn-svc__link"
                               href="@AppSettings.VenemergenciaUrl"
                               target="_blank"
                               rel="noopener noreferrer">
                                Ir a Venemergencia
                            </a>
                        }
                        else
                        {
                            <p class="cn-svc__error">El enlace de Venemergencia no está configurado.</p>
                        }
                    }
                    else
                    {
                        <p class="cn-svc__lead">Indícanos la siguiente información para conectarte con nuestros médicos:</p>

                        <div class="cn-svc__field">
                            <label class="cn-svc__label" for="motivo">Motivo</label>
                            <textarea id="motivo" class="cn-svc__textarea" maxlength="300" @bind="motivo" @bind:event="oninput"></textarea>
                        </div>
                        <div class="cn-svc__field">
                            <label class="cn-svc__label" for="direccion">Dirección</label>
                            <input id="direccion" class="cn-svc__input" maxlength="200" @bind="direccion" @bind:event="oninput" />
                        </div>
                        <div class="cn-svc__field">
                            <label class="cn-svc__label" for="telefono">Teléfono celular</label>
                            <input id="telefono" class="cn-svc__input" inputmode="tel" maxlength="20" autocomplete="tel" @bind="telefono" @bind:event="oninput" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <p class="cn-svc__error" role="alert">@errorMessage</p>
                        }

                        <button type="button" class="cn-svc__cta" disabled="@enviando" @onclick="EnviarWhatsAppAsync">
                            Continuar por WhatsApp
                        </button>
                    }
                </section>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool cargando = true;
    private bool esLis;
    private bool enviando;
    private string motivo = string.Empty;
    private string direccion = string.Empty;
    private string telefono = string.Empty;
    private string errorMessage = string.Empty;
    private AppModule? modulo;

    private string Titulo => modulo?.Label ?? "Servicio";

    protected override async Task OnInitializedAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        modulo = AppModules.FindByRoute(path);

        var perfil = await PerfilService.GetAsync();
        esLis = perfil.EsLis;
        cargando = false;
    }

    private void GoHome() => Navigation.NavigateTo("Home");

    private async Task EnviarWhatsAppAsync()
    {
        errorMessage = string.Empty;
        var motivoOk = motivo.Trim();
        var direccionOk = direccion.Trim();
        var telefonoOk = WhatsAppLink.DigitsOnly(telefono);

        if (motivoOk.Length is < 3 or > 300)
        {
            errorMessage = "Escribe el motivo de la atención.";
            return;
        }

        if (direccionOk.Length < 5)
        {
            errorMessage = "Indica una dirección válida.";
            return;
        }

        if (telefonoOk.Length < 10)
        {
            errorMessage = "Indica un celular válido (mínimo 10 dígitos).";
            return;
        }

        var mensaje = string.Join(
            Environment.NewLine,
            Titulo,
            $"Motivo: {motivoOk}",
            $"Dirección: {direccionOk}",
            $"Celular: {telefonoOk}");

        var url = WhatsAppLink.Chat(AppSettings.WhatsAppCuidamed, mensaje);
        if (url is null)
        {
            errorMessage = "El WhatsApp de Cuidamed no está configurado.";
            return;
        }

        enviando = true;
        try
        {
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        finally
        {
            enviando = false;
        }
    }
}

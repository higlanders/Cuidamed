@page "/telemedicina"
@page "/amd"
@layout EmptyLayout
@using Cuidanet.Models
@using Cuidanet.Services
@inject NavigationManager Navigation
@inject CuidanetAppSettings AppSettings
@inject LisRouteGuard LisGuard
@inject BrandProfile Brand

<PageTitle>@Brand.Title(Titulo)</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-svc">
            <div class="cn-svc__shell">
                <PageHeader Title="@Titulo" Back="GoHome" />

                <section class="cn-svc__sheet">
                    <div class="cn-svc__partners" aria-label="Aliados del servicio">
                        <img class="cn-svc__partner"
                             src="brands/internacional/logo.svg"
                             alt="La Internacional de Seguros"
                             width="280"
                             height="80" />
                        <img class="cn-svc__partner"
                             src="brands/venemergencia/logo-color.svg"
                             alt="Venemergencia"
                             width="272"
                             height="80" />
                    </div>

                    <p class="cn-svc__lead">@Instrucciones</p>

                    @if (EnlaceLlamada is null)
                    {
                        <p class="cn-svc__error">El teléfono de la central no está configurado.</p>
                    }
                    else
                    {
                        <a class="cn-svc__cta" href="@EnlaceLlamada">
                            <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                            Llamar @TelefonoMostrar
                        </a>
                    }
                </section>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private AppModule? modulo;

    private string Titulo => modulo?.Label ?? "Servicio";

    private string TelefonoMostrar => AppSettings.TelefonoTelemedicina;

    private string Instrucciones =>
        $"Para solicitar una telemedicina, debe comunicarse a través de nuestra central telefónica {TelefonoMostrar}. " +
        "Al llamar, marque la Opción # 1 para Seguros de Personas, luego la Opción # 1 para atención al asegurado " +
        "y finalmente la Opción # 3 para Asistencia Médica InSitu o Telemedicina. Le solicitarán ingresar su número de cédula.";

    private string? EnlaceLlamada
    {
        get
        {
            var raw = TelefonoMostrar;
            if (string.IsNullOrWhiteSpace(raw))
                return null;

            var digits = new string(raw.Where(char.IsDigit).ToArray());
            if (digits.Length is < 3 or > 15)
                return null;

            return raw.TrimStart().StartsWith('+') ? $"tel:+{digits}" : $"tel:{digits}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await LisGuard.EnsureAllowedAsync())
            return;

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        modulo = AppModules.FindByRoute(path);
    }

    private void GoHome() => Navigation.NavigateTo("Home");
}

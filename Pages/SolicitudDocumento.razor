@page "/cartas-avales"
@page "/reembolso"
@layout EmptyLayout
@using System.IO
@using Cuidanet.Models
@using Cuidanet.Services
@inject NavigationManager Navigation
@inject AfiliadoPerfilService PerfilService
@inject CuidanetAppSettings AppSettings
@inject CuidanetApiClient CuidanetService
@inject IJSRuntime JS

<PageTitle>Cuidanet — @Titulo</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (!cargando && !esLis)
        {
            <div class="cn-lab">
                <div class="cn-lab__shell">
                    <header class="cn-lab__hero">
                        <div class="cn-lab__hero-glow" aria-hidden="true"></div>
                        <div class="cn-lab__topbar">
                            <button type="button" class="cn-lab__back" @onclick="GoHome" aria-label="Volver al inicio">
                                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            </button>
                            <h1 class="cn-lab__heading">@Titulo</h1>
                            <span class="cn-lab__topbar-spacer" aria-hidden="true"></span>
                        </div>
                        <p class="cn-lab__lead">Toma o carga las imágenes de la documentación para enviar la solicitud.</p>
                    </header>

                    <section class="cn-lab__sheet">
                        <div class="cn-lab__tabs" role="tablist" aria-label="Origen del documento">
                            <button type="button"
                                    role="tab"
                                    aria-selected="@(origenSeleccionado == OrigenMedia.Camara)"
                                    class="cn-lab__tab @(origenSeleccionado == OrigenMedia.Camara ? "is-active" : "")"
                                    @onclick="() => CambiarOrigen(OrigenMedia.Camara)">
                                <i class="bi bi-camera-fill" aria-hidden="true"></i>
                                Cámara
                            </button>
                            <button type="button"
                                    role="tab"
                                    aria-selected="@(origenSeleccionado == OrigenMedia.Archivo)"
                                    class="cn-lab__tab @(origenSeleccionado == OrigenMedia.Archivo ? "is-active" : "")"
                                    @onclick="() => CambiarOrigen(OrigenMedia.Archivo)">
                                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                Archivo
                            </button>
                        </div>

                        @if (origenSeleccionado == OrigenMedia.Camara)
                        {
                            <div class="cn-lab__camera">
                                <div class="cn-lab__viewport @(cameraInitialized ? "is-live" : "")">
                                    <video id="doc-webcam" autoplay playsinline muted class="cn-lab__video"></video>
                                    <canvas id="doc-capture" class="cn-lab__canvas"></canvas>
                                    @if (!cameraInitialized)
                                    {
                                        <div class="cn-lab__viewport-empty">
                                            <i class="bi bi-camera-video" aria-hidden="true"></i>
                                            <p>Enciende la cámara para capturar el documento</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="cn-lab__frame" aria-hidden="true">
                                            <span class="cn-lab__corner cn-lab__corner--tl"></span>
                                            <span class="cn-lab__corner cn-lab__corner--tr"></span>
                                            <span class="cn-lab__corner cn-lab__corner--bl"></span>
                                            <span class="cn-lab__corner cn-lab__corner--br"></span>
                                        </div>
                                        <p class="cn-lab__viewport-hint">Centra el documento dentro del marco</p>
                                    }
                                </div>

                                @if (!cameraInitialized)
                                {
                                    <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="InicializarCamara" disabled="@isUploading">
                                        <i class="bi bi-camera" aria-hidden="true"></i>
                                        Encender cámara
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="cn-lab__btn cn-lab__btn--primary"
                                            @onclick="TomarYSubirFoto"
                                            disabled="@isUploading">
                                        @if (isUploading)
                                        {
                                            <span class="cn-lab__spinner" aria-hidden="true"></span>
                                            <span>Procesando...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-cloud-arrow-up-fill" aria-hidden="true"></i>
                                            <span>Capturar y enviar</span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="cn-lab__drop @(isUploading ? "is-busy" : "")">
                                <label class="cn-lab__drop-area">
                                    <InputFile OnChange="HandleFileSelected"
                                               class="cn-lab__file-input"
                                               accept="image/png,image/jpeg,application/pdf"
                                               disabled="@isUploading" />
                                    <span class="cn-lab__drop-icon" aria-hidden="true">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                    </span>
                                    <span class="cn-lab__drop-title">Toca para elegir un archivo</span>
                                    <span class="cn-lab__drop-hint">JPG, PNG o PDF · máx. 100 MB</span>
                                </label>

                                @if (!string.IsNullOrEmpty(selectedFileName))
                                {
                                    <div class="cn-lab__file-chip">
                                        <i class="bi bi-file-earmark-medical" aria-hidden="true"></i>
                                        <span>@selectedFileName</span>
                                    </div>
                                }

                                @if (isUploading)
                                {
                                    <p class="cn-lab__busy">
                                        <span class="cn-lab__spinner" aria-hidden="true"></span>
                                        <span>Subiendo archivo...</span>
                                    </p>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(statusMessage))
                        {
                            <div class="cn-lab__status @StatusClass" role="status">
                                <i class="bi @StatusIcon" aria-hidden="true"></i>
                                <p>@statusMessage</p>
                            </div>
                        }

                        @if (ultimoRegistroUploaded != null)
                        {
                            <div class="cn-lab__success">
                                <div class="cn-lab__success-badge" aria-hidden="true">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <h2 class="cn-lab__success-title">Documento enviado</h2>
                                <p class="cn-lab__success-lead">Tu archivo quedó registrado en CuidaNet.</p>
                                <dl class="cn-lab__meta">
                                    <div>
                                        <dt>ID imagen</dt>
                                        <dd>@ultimoRegistroUploaded.ImagenesId</dd>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ultimoRegistroUploaded.Periodo))
                                    {
                                        <div>
                                            <dt>Periodo</dt>
                                            <dd>@ultimoRegistroUploaded.Periodo</dd>
                                        </div>
                                    }
                                </dl>
                                <div class="cn-lab__success-actions">
                                    @if (!string.IsNullOrWhiteSpace(UrlParaVer))
                                    {
                                        <button type="button" class="cn-lab__btn cn-lab__btn--ghost" @onclick="VerDocumentoAsync">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                            Ver documento
                                        </button>
                                    }
                                    <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="ResetUpload">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        Subir otro
                                    </button>
                                </div>
                            </div>
                        }

                        <p class="cn-lab__footnote">
                            Usa buena luz y enfoca el documento para una captura nítida.
                        </p>
                    </section>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private enum OrigenMedia { Camara, Archivo }

    private OrigenMedia origenSeleccionado = OrigenMedia.Camara;
    private bool cargando = true;
    private bool esLis;
    private bool cameraInitialized;
    private bool isUploading;
    private string statusMessage = string.Empty;
    private string statusTone = "info";
    private string selectedFileName = string.Empty;
    private UploadImagenResponse? ultimoRegistroUploaded;
    private AppModule? modulo;
    private const long MaxFileSizeBytes = 100 * 1024 * 1024;

    private string Titulo => modulo?.Label ?? "Solicitud";
    // Reembolsos/PresupuestoCA exigen IDs de solicitud que la app aún no crea.
    // Usamos Servicio (mismo flujo que Laboratorios) para poder guardar la documentación.
    private string Carpeta => "Servicio";

    private string? UrlParaVer
    {
        get
        {
            if (ultimoRegistroUploaded is null) return null;
            if (!string.IsNullOrWhiteSpace(ultimoRegistroUploaded.UrlPublica))
                return ultimoRegistroUploaded.UrlPublica;
            if (!string.IsNullOrWhiteSpace(ultimoRegistroUploaded.Url))
                return ultimoRegistroUploaded.Url;
            return null;
        }
    }

    private string StatusClass => statusTone switch
    {
        "success" => "cn-lab__status--success",
        "warning" => "cn-lab__status--warning",
        "danger" => "cn-lab__status--danger",
        _ => "cn-lab__status--info"
    };

    private string StatusIcon => statusTone switch
    {
        "success" => "bi-check-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "danger" => "bi-x-circle-fill",
        _ => "bi-info-circle-fill"
    };

    protected override async Task OnInitializedAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        modulo = AppModules.FindByRoute(path);

        var perfil = await PerfilService.GetAsync();
        esLis = perfil.EsLis;
        cargando = false;

        if (esLis)
            Navigation.NavigateTo("Home");
    }

    private void GoHome() => Navigation.NavigateTo("Home");

    private async Task VerDocumentoAsync()
    {
        if (string.IsNullOrWhiteSpace(UrlParaVer))
            return;

        var ok = await JS.InvokeAsync<bool>("CuidanetUi.openUrlHidden", UrlParaVer);
        if (!ok)
        {
            statusMessage = "No se pudo abrir el documento. Permite ventanas emergentes e intenta de nuevo.";
            statusTone = "warning";
        }
    }

    private void CambiarOrigen(OrigenMedia nuevoOrigen)
    {
        origenSeleccionado = nuevoOrigen;
        statusMessage = string.Empty;
        selectedFileName = string.Empty;
        ultimoRegistroUploaded = null;
    }

    private void ResetUpload()
    {
        statusMessage = string.Empty;
        selectedFileName = string.Empty;
        ultimoRegistroUploaded = null;
    }

    private async Task InicializarCamara()
    {
        statusMessage = "Solicitando permisos de cámara…";
        statusTone = "info";

        var ok = await JS.InvokeAsync<bool>("BlazorCamera.start", "doc-webcam");
        cameraInitialized = ok;
        statusMessage = ok
            ? "Cámara lista. Posiciona el documento frente al lente."
            : "No se pudo acceder a la cámara. Revisa los permisos del navegador.";
        statusTone = ok ? "success" : "danger";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file is null) return;

            selectedFileName = file.Name;

            if (file.Size > MaxFileSizeBytes)
            {
                statusMessage = "El archivo excede el límite permitido de 100 MB.";
                statusTone = "danger";
                return;
            }

            isUploading = true;
            statusMessage = "Enviando archivo a CuidaNet…";
            statusTone = "info";
            ultimoRegistroUploaded = null;
            StateHasChanged();

            using var stream = file.OpenReadStream(MaxFileSizeBytes);
            ultimoRegistroUploaded = await CuidanetService.UploadImagenAsync(
                fileStream: stream,
                fileName: file.Name,
                carpeta: Carpeta,
                servicioId: AppSettings.ServicioImagenDocumentos,
                fuente: AppSettings.ImagenFuente);

            statusMessage = "Archivo subido correctamente.";
            statusTone = "success";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error al cargar el archivo: {ex.Message}";
            statusTone = "danger";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task TomarYSubirFoto()
    {
        try
        {
            isUploading = true;
            statusMessage = "Procesando captura…";
            statusTone = "info";
            ultimoRegistroUploaded = null;
            StateHasChanged();

            var dataUrl = await JS.InvokeAsync<string>("BlazorCamera.capture", "doc-webcam", "doc-capture");
            if (string.IsNullOrEmpty(dataUrl) || !dataUrl.Contains(','))
                throw new InvalidOperationException("La captura falló o el video está vacío.");

            var bytes = Convert.FromBase64String(dataUrl.Split(',')[1]);
            using var memory = new MemoryStream(bytes);
            var nombre = $"Captura_{DateTime.Now:yyyyMMdd_HHmmss}.jpg";

            statusMessage = "Transmitiendo a CuidaNet…";
            StateHasChanged();

            ultimoRegistroUploaded = await CuidanetService.UploadImagenAsync(
                fileStream: memory,
                fileName: nombre,
                carpeta: Carpeta,
                servicioId: AppSettings.ServicioImagenDocumentos,
                fuente: AppSettings.ImagenFuente);

            statusMessage = "Captura guardada correctamente.";
            statusTone = "success";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error durante el proceso de cámara: {ex.Message}";
            statusTone = "danger";
        }
        finally
        {
            isUploading = false;
        }
    }
}

@page "/terminos"
@layout EmptyLayout
@using Cuidanet.Models
@inject NavigationManager Navigation

<PageTitle>Cuidanet — Términos y Condiciones</PageTitle>

<div class="cn-terms">
    <div class="cn-terms__shell">
        <PageHeader Title="Términos y Condiciones" Back="Volver" BackLabel="Volver al acceso" />
        <section class="cn-page__sheet">
            <p class="cn-terms__body">@TerminosCondiciones.Texto</p>
        </section>
    </div>
</div>

@code {
    private void Volver() => Navigation.NavigateTo("./");
}

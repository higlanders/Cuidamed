@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Cuidamed.Services
@using Cuidamed.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject CuidanetApiClient CuidanetService
@implements IDisposable

<PageTitle>Cuidanet</PageTitle>

<div class="cn-login-page">
    <div class="cn-login-shell">
        <header class="cn-login-hero @(CurrentStep == LoginStep.Afiliado ? "cn-login-hero--compact" : "")">
            <div class="cn-login-hero__glow" aria-hidden="true"></div>
            <img src="LogoCuidaNet.png" alt="CuidaNet" class="cn-login-hero__logo" />
            <p class="cn-login-hero__slogan">"Cuidarte nos mueve"</p>
        </header>

        <section class="cn-login-sheet">
            <div class="cn-login-progress" role="progressbar"
                 aria-valuemin="1" aria-valuemax="4" aria-valuenow="@((int)CurrentStep)"
                 aria-label="Progreso de acceso">
                <span class="cn-login-progress__seg @(CurrentStep > LoginStep.Cedula ? "is-done" : CurrentStep == LoginStep.Cedula ? "is-active" : "")"></span>
                <span class="cn-login-progress__seg @(CurrentStep > LoginStep.Telefono ? "is-done" : CurrentStep == LoginStep.Telefono ? "is-active" : "")"></span>
                <span class="cn-login-progress__seg @(CurrentStep > LoginStep.SmsCodigo ? "is-done" : CurrentStep == LoginStep.SmsCodigo ? "is-active" : "")"></span>
                <span class="cn-login-progress__seg @(CurrentStep == LoginStep.Afiliado ? "is-active" : "")"></span>
            </div>

            @if (CurrentStep == LoginStep.Afiliado)
            {
                <div class="cn-login-step cn-login-step--afiliado" @key="@("afiliado")">
                    <div class="cn-login-success">
                        <span class="cn-login-success__icon" aria-hidden="true">✓</span>
                        <span>Verificación SMS correcta</span>
                    </div>

                    <h1 class="cn-login-step__title">Selecciona afiliado</h1>
                    <p class="cn-login-step__subtitle">Elige quién ingresará y acepta los términos para continuar.</p>

                    <div class="cn-login-afiliados" role="listbox" aria-label="Grupo familiar">
                        @foreach (var afiliado in listaAfiliados)
                        {
                            var idStr = afiliado.BeneficiarioId.ToString();
                            var selected = AfiliadoSeleccionadoValue == idStr;
                            <button type="button"
                                    role="option"
                                    aria-selected="@selected"
                                    class="cn-login-afiliado @(selected ? "is-selected" : "")"
                                    @onclick="() => SelectAfiliadoAsync(afiliado.BeneficiarioId)">
                                @if (selected && afiliadoDetalle != null && !string.IsNullOrEmpty(afiliadoDetalle.FotoBase64)
                                    && afiliadoDetalle.BeneficiarioId == afiliado.BeneficiarioId)
                                {
                                    <img class="cn-login-afiliado__avatar"
                                         src="data:image/jpeg;base64,@afiliadoDetalle.FotoBase64"
                                         alt="" />
                                }
                                <span class="cn-login-afiliado__meta">
                                    <span class="cn-login-afiliado__id">@afiliado.NombreCompleto</span>
                                    <span class="cn-login-afiliado__cedula">Cédula @afiliado.Cedula</span>
                                </span>
                                <span class="cn-login-afiliado__radio" aria-hidden="true"></span>
                            </button>
                        }
                    </div>

                    @if (afiliadoDetalle != null && !string.IsNullOrEmpty(afiliadoDetalle.FotoBase64))
                    {
                        <div class="cn-login-photo-preview">
                            <img src="data:image/jpeg;base64,@afiliadoDetalle.FotoBase64" alt="Foto del afiliado seleccionado" />
                        </div>
                    }

                    <div class="cn-login-terms">
                        <div class="cn-login-terms__panel" tabindex="0">@TermsText</div>
                        <label class="cn-login-check">
                            <input type="checkbox" @bind="AceptoTerminos" />
                            <span class="cn-login-check__box" aria-hidden="true"></span>
                            <span class="cn-login-check__label">Acepto los Términos y Condiciones</span>
                        </label>
                    </div>

                    <div class="cn-login-footer-space">
                        <button type="button"
                                class="cn-login-cta"
                                disabled="@(!CanEnter || isLoading)"
                                @onclick='() => NavigateTo("Home")'>
                            @if (isLoading)
                            {
                                <span class="cn-login-cta__spinner" aria-hidden="true"></span>
                                <span>Ingresando…</span>
                            }
                            else
                            {
                                <span>Entrar</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="cn-login-step" @key="@CurrentStep.ToString()">
                    <h1 class="cn-login-step__title">@StepTitle</h1>
                    <p class="cn-login-step__subtitle">@StepSubtitle</p>

                    <EditForm Model="loginModel" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        @if (CurrentStep == LoginStep.Cedula)
                        {
                            <div class="cn-login-field">
                                <label class="cn-login-label" for="cedula">Cédula</label>
                                <InputNumber id="cedula"
                                             class="cn-login-input"
                                             @bind-Value="loginModel.Cedula"
                                             placeholder="Ej. 12345678"
                                             inputmode="numeric"
                                             autocomplete="username" />
                            </div>
                        }

                        @if (CurrentStep == LoginStep.Telefono)
                        {
                            <div class="cn-login-field">
                                <label class="cn-login-label" for="cedulaReadonly">Cédula</label>
                                <InputNumber id="cedulaReadonly"
                                             class="cn-login-input"
                                             @bind-Value="loginModel.Cedula"
                                             readonly="true" />
                            </div>
                            <div class="cn-login-field">
                                <label class="cn-login-label" for="telefono">Celular</label>
                                <InputText id="telefono"
                                           class="cn-login-input"
                                           @bind-Value="loginModel.Telefono"
                                           placeholder="Ej. 04141234567"
                                           inputmode="tel"
                                           autocomplete="tel" />
                                <p class="cn-login-hint">Te enviaremos un código SMS a este número.</p>
                            </div>
                        }

                        @if (CurrentStep == LoginStep.SmsCodigo)
                        {
                            <div class="cn-login-field">
                                <label class="cn-login-label" for="telefonoReadonly">Celular</label>
                                <InputText id="telefonoReadonly"
                                           class="cn-login-input"
                                           @bind-Value="loginModel.Telefono"
                                           readonly="true" />
                            </div>
                            <div class="cn-login-field">
                                <label class="cn-login-label" for="codigoSms">Código de verificación</label>
                                <InputText id="codigoSms"
                                           class="cn-login-input cn-login-input--otp"
                                           @bind-Value="loginModel.CodigoSms"
                                           placeholder="••••"
                                           inputmode="numeric"
                                           maxlength="8"
                                           autocomplete="one-time-code" />
                                <div class="cn-login-timer" role="status">
                                    <span>Expira en <strong>@FormatTime(timeLeft)</strong></span>
                                    <button type="button"
                                            class="cn-login-link"
                                            disabled="@(isLoading || timeLeft > 90)"
                                            @onclick="ResendSmsAsync">
                                        Reenviar código
                                    </button>
                                </div>
                            </div>
                        }

                        <button type="submit" class="cn-login-cta" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="cn-login-cta__spinner" aria-hidden="true"></span>
                                <span>@CtaLoadingLabel</span>
                            }
                            else
                            {
                                <span>@CtaLabel</span>
                            }
                        </button>

                        @if (CurrentStep != LoginStep.Cedula)
                        {
                            <button type="button" class="cn-login-back" disabled="@isLoading" @onclick="GoBack">
                                Volver
                            </button>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="cn-login-error" role="alert">@errorMessage</div>
                        }
                    </EditForm>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private enum LoginStep
    {
        Cedula = 1,
        Telefono = 2,
        SmsCodigo = 3,
        Afiliado = 4
    }

    private LoginViewModel loginModel = new();
    private LoginStep CurrentStep = LoginStep.Cedula;
    private bool isLoading = false;
    private bool AceptoTerminos { get; set; } = false;
    private string errorMessage = string.Empty;
    private List<BeneficiarioDto> listaAfiliados = new();
    private System.Threading.Timer? countdownTimer;
    private int timeLeft = 120;
    private BeneficiarioDto? afiliadoDetalle;
    private string _afiliadoSeleccionado = string.Empty;

    private string AfiliadoSeleccionadoValue
    {
        get => _afiliadoSeleccionado;
        set => _afiliadoSeleccionado = value;
    }

    private bool CanEnter => !string.IsNullOrEmpty(AfiliadoSeleccionadoValue) && AceptoTerminos;

    private string StepTitle => CurrentStep switch
    {
        LoginStep.Cedula => "Bienvenido",
        LoginStep.Telefono => "Verifica tu celular",
        LoginStep.SmsCodigo => "Código SMS",
        _ => "Selecciona afiliado"
    };

    private string StepSubtitle => CurrentStep switch
    {
        LoginStep.Cedula => "Ingresa tu cédula para acceder a tu portal de salud.",
        LoginStep.Telefono => "Confirma el número donde recibirás el código de verificación.",
        LoginStep.SmsCodigo => $"Ingresa el código que enviamos a {MaskPhone(loginModel.Telefono)}.",
        _ => string.Empty
    };

    private string CtaLabel => CurrentStep switch
    {
        LoginStep.Cedula => "Continuar",
        LoginStep.Telefono => "Enviar SMS",
        LoginStep.SmsCodigo => "Verificar código",
        _ => "Entrar"
    };

    private string CtaLoadingLabel => CurrentStep switch
    {
        LoginStep.Cedula => "Validando…",
        LoginStep.Telefono => "Enviando SMS…",
        LoginStep.SmsCodigo => "Verificando…",
        _ => "Ingresando…"
    };

    private const string TermsText =
@"CONTRATO DE TÉRMINOS Y CONDICIONES DEL SERVICIO

1. ACEPTACIÓN DE LOS TÉRMINOS
Al acceder y utilizar este portal, usted acepta cumplir y estar sujeto a los siguientes términos y condiciones de uso. Si no está de acuerdo con alguna parte de estos términos, no deberá acceder al servicio.

2. DESCRIPCIÓN DEL SERVICIO
El portal provee una plataforma de verificación y gestión para los afiliados y su grupo familiar, permitiendo agilizar los trámites correspondientes a su cobertura de salud y beneficios integrales.

3. OBLIGACIONES DEL USUARIO
El usuario se compromete a proporcionar información verídica, exacta y actualizada durante el proceso de validación. Queda estrictamente prohibido el uso de identidades falsas o información de terceros sin su debida autorización legal.

4. PRIVACIDAD Y PROTECCIÓN DE DATOS
Toda la información recolectada a través de este portal será tratada bajo estrictas políticas de confidencialidad y de conformidad con las leyes vigentes de protección de datos personales. Los datos del titular y su grupo familiar se procesan únicamente con fines de autenticación y servicio.

5. MODIFICACIONES AL ACUERDO
Nos reservamos el derecho de modificar estos términos en cualquier momento. Las modificaciones entrarán en vigencia inmediatamente después de su publicación en el portal. Su uso continuo del servicio constituirá su aceptación de tales cambios.

6. LIMITACIÓN DE RESPONSABILIDAD
La entidad no se hace responsable por interrupciones temporales del servicio debidas a mantenimiento técnico, fallas de conectividad externas o causas de fuerza mayor. El usuario es responsable de salvaguardar sus datos de acceso.";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var authState = await AuthState;
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                Navigation.NavigateTo("Home");
            }
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;
        isLoading = true;

        try
        {
            switch (CurrentStep)
            {
                case LoginStep.Cedula:
                    await ValidateCedulaAsync();
                    break;
                case LoginStep.Telefono:
                    await EnviarSmsAsync();
                    break;
                case LoginStep.SmsCodigo:
                    await VerificarSmsAsync();
                    break;
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ValidateCedulaAsync()
    {
        if (!loginModel.Cedula.HasValue || loginModel.Cedula <= 0)
        {
            errorMessage = "Ingresa una cédula válida.";
            return;
        }

        try
        {
            var resultado = await CuidanetService.GetBeneficiariosAsync(cedula: loginModel.Cedula.ToString());
            if (resultado == null || !resultado.Any())
            {
                errorMessage = "La cédula ingresada no se encuentra registrada en el sistema de CuidaNet.";
                return;
            }

            CurrentStep = LoginStep.Telefono;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de comunicación con la API: {ex.Message}";
        }
    }

    private async Task EnviarSmsAsync()
    {
        var telefono = NormalizePhone(loginModel.Telefono);
        if (!IsValidPhone(telefono))
        {
            errorMessage = "Ingresa un celular válido (mínimo 10 dígitos).";
            return;
        }

        loginModel.Telefono = telefono;

        try
        {
            var response = await CuidanetService.EnviarSmsAsync(
                loginModel.Cedula!.Value.ToString(),
                telefono);

            if (response.IsExplicitFailure)
            {
                errorMessage = response.UserMessage ?? "No se pudo enviar el SMS. Intenta de nuevo.";
                return;
            }

            loginModel.CodigoSms = string.Empty;
            CurrentStep = LoginStep.SmsCodigo;
            StartCountdown();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo enviar el SMS: {ex.Message}";
        }
    }

    private async Task VerificarSmsAsync()
    {
        var codigo = (loginModel.CodigoSms ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(codigo))
        {
            errorMessage = "Ingresa el código SMS recibido.";
            return;
        }

        try
        {
            var response = await CuidanetService.VerificarSmsAsync(
                loginModel.Cedula!.Value.ToString(),
                loginModel.Telefono ?? string.Empty,
                codigo);

            if (response.IsExplicitFailure)
            {
                errorMessage = response.UserMessage ?? "El código SMS es incorrecto o ha expirado.";
                return;
            }

            StopTimer();
            await LoadGrupoFamiliarAsync();
            CurrentStep = LoginStep.Afiliado;
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo verificar el SMS: {ex.Message}";
        }
    }

    private async Task ResendSmsAsync()
    {
        errorMessage = string.Empty;
        isLoading = true;
        try
        {
            await EnviarSmsAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadGrupoFamiliarAsync()
    {
        var busquedaInicial = await CuidanetService.GetBeneficiariosAsync(cedula: loginModel.Cedula.ToString());
        if (busquedaInicial.Any())
        {
            int titularId = busquedaInicial.First().TitularId;
            listaAfiliados = await CuidanetService.GetBeneficiariosAsync(titularId: titularId);
        }
    }

    private void GoBack()
    {
        errorMessage = string.Empty;
        if (CurrentStep == LoginStep.Telefono)
        {
            CurrentStep = LoginStep.Cedula;
        }
        else if (CurrentStep == LoginStep.SmsCodigo)
        {
            StopTimer();
            loginModel.CodigoSms = string.Empty;
            CurrentStep = LoginStep.Telefono;
        }
    }

    private void StartCountdown()
    {
        StopTimer();
        timeLeft = 120;
        countdownTimer = new System.Threading.Timer(async _ =>
        {
            if (timeLeft > 0)
            {
                timeLeft--;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                StopTimer();
                errorMessage = "El código SMS expiró. Solicita uno nuevo.";
                await InvokeAsync(StateHasChanged);
            }
        }, null, 0, 1000);
    }

    private void StopTimer()
    {
        countdownTimer?.Dispose();
        countdownTimer = null;
    }

    private string FormatTime(int seconds)
    {
        int minutes = seconds / 60;
        int remainingSeconds = seconds % 60;
        return $"{minutes:D2}:{remainingSeconds:D2}";
    }

    private static string NormalizePhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return string.Empty;

        // Igual que ControladorMensajesSmsGateway.NormalizarCelular (EnvioSmsGateway)
        return new string(phone.Where(char.IsDigit).ToArray());
    }

    private static bool IsValidPhone(string phone) =>
        !string.IsNullOrWhiteSpace(phone) && phone.Length >= 10 && phone.Length <= 15;

    private static string MaskPhone(string? phone)
    {
        var digits = NormalizePhone(phone);
        if (digits.Length < 4)
            return "tu celular";

        return $"•••{digits[^4..]}";
    }

    public void Dispose() => StopTimer();

    private async Task SelectAfiliadoAsync(int beneficiarioId)
    {
        AfiliadoSeleccionadoValue = beneficiarioId.ToString();
        try
        {
            afiliadoDetalle = await CuidanetService.GetBeneficiarioDetalleAsync(beneficiarioId);
        }
        catch (Exception)
        {
            afiliadoDetalle = null;
        }
    }

    public class LoginViewModel
    {
        public long? Cedula { get; set; }
        public string Telefono { get; set; } = string.Empty;
        public string CodigoSms { get; set; } = string.Empty;
    }

    private async Task NavigateTo(string page)
    {
        if (string.IsNullOrEmpty(AfiliadoSeleccionadoValue) || !AceptoTerminos)
            return;

        isLoading = true;
        try
        {
            var customAuth = (CustomAuthStateProvider)AuthStateProvider;
            long temp = loginModel.Cedula is null ? 0 : Convert.ToInt64(loginModel.Cedula);
            await customAuth.MarkUserAsAuthenticated(temp);
            Navigation.NavigateTo($"{page}");
        }
        finally
        {
            isLoading = false;
        }
    }
}

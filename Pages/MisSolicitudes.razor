@page "/mis-solicitudes"
@layout EmptyLayout
@using Cuidanet.Models
@using Cuidanet.Services
@inject NavigationManager Navigation
@inject AfiliadoPerfilService PerfilService
@inject CuidanetApiClient CuidanetService
@inject AuthenticationStateProvider AuthStateProvider
@inject BrandProfile Brand

<PageTitle>@Brand.Title("Mis solicitudes")</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-lab">
            <div class="cn-lab__shell">
                <PageHeader Title="Mis solicitudes"
                            Lead="Revisa el estado de tus solicitudes de medicamentos."
                            Back="GoHome" />

                <section class="cn-lab__sheet">
                    @if (grupoFamiliar.Count > 0)
                    {
                        <div class="cn-lab__field" style="margin-bottom:1rem;">
                            <label class="cn-lab__label" id="lbl-asegurado">Asegurado</label>
                            <p class="cn-lab__drop-hint" style="margin:0 0 0.45rem;">
                                Elige de quién quieres ver las solicitudes.
                            </p>
                            <div class="cn-lab__familia" role="listbox" aria-labelledby="lbl-asegurado">
                                @foreach (var afiliado in grupoFamiliar)
                                {
                                    var selected = beneficiarioSeleccionadoId == afiliado.BeneficiarioId;
                                    <button type="button"
                                            role="option"
                                            aria-selected="@selected"
                                            class="cn-lab__familia-item @(selected ? "is-selected" : "")"
                                            disabled="@cargando"
                                            @onclick="() => SeleccionarAseguradoAsync(afiliado)">
                                        <span class="cn-lab__familia-avatar" aria-hidden="true">
                                            @GetInitials(afiliado)
                                        </span>
                                        <span class="cn-lab__familia-meta">
                                            <span class="cn-lab__familia-nombre">@afiliado.NombreCompleto</span>
                                            <span class="cn-lab__familia-cedula">Cédula @afiliado.Cedula</span>
                                        </span>
                                        <span class="cn-lab__familia-radio" aria-hidden="true"></span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="cn-lab__btn-row" style="margin-bottom:1rem;margin-top:0;">
                        <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="NuevaSolicitud">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            Nueva solicitud
                        </button>
                    </div>

                    @if (cargando)
                    {
                        <div class="cn-lab__status cn-lab__status--info" role="status">
                            <span class="cn-lab__spinner" aria-hidden="true"></span>
                            <p>Cargando solicitudes…</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <div class="cn-lab__status cn-lab__status--danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                            <p>@errorMsg</p>
                        </div>
                        <div class="cn-lab__btn-row">
                            <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="CargarAsync">Reintentar</button>
                        </div>
                    }
                    else if (items.Count == 0)
                    {
                        <div class="cn-lab__status cn-lab__status--info" role="status">
                            <i class="bi bi-inbox" aria-hidden="true"></i>
                            <p>
                                @if (!string.IsNullOrWhiteSpace(textoAseguradoSeleccionado))
                                {
                                    <text>Aún no hay solicitudes de medicamentos para @textoAseguradoSeleccionado.</text>
                                }
                                else
                                {
                                    <text>Aún no tienes solicitudes de medicamentos.</text>
                                }
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="cn-lab__anexo-list" aria-label="Solicitudes">
                            @foreach (var s in items)
                            {
                                var beneficiario = TextoBeneficiario(s);
                                <button type="button"
                                        class="cn-lab__anexo"
                                        style="width:100%;text-align:left;cursor:pointer;"
                                        @onclick="() => Abrir(s.SolicitudId)">
                                    <div class="cn-lab__anexo-head">
                                        <p class="cn-lab__anexo-title">Solicitud #@s.SolicitudId</p>
                                        <span class="cn-lab__anexo-badge">@EtiquetaStatus(s.Status)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(beneficiario))
                                    {
                                        <p class="cn-lab__drop-hint" style="margin:0.15rem 0 0;">
                                            @beneficiario
                                        </p>
                                    }
                                    <p class="cn-lab__drop-hint" style="margin:0;">
                                        @s.FechaCrea.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        · @s.CantidadAdjuntos adjunto(s)
                                        @if (s.PuedeEditar)
                                        {
                                            <span> · Se puede corregir</span>
                                        }
                                    </p>
                                    @if (string.Equals(s.Status, "Error", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <p class="cn-lab__footnote" style="color:var(--cn-orange);margin-top:0.35rem;">
                                            No se pudo completar. Abre la solicitud para corregir documentos.
                                        </p>
                                    }
                                </button>
                            }
                        </div>
                    }
                </section>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool cargando = true;
    private string? errorMsg;
    private string textoAseguradoSeleccionado = string.Empty;
    private int? beneficiarioSeleccionadoId;
    private List<ReembolsoSolicitudListaDto> items = [];
    private List<BeneficiarioDto> grupoFamiliar = [];
    private Dictionary<int, (string Nombre, string Cedula)> beneficiariosPorId = new();

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        errorMsg = null;
        try
        {
            var perfil = await PerfilService.GetAsync();
            await CargarGrupoFamiliarAsync(perfil.BeneficiarioId);

            if (beneficiarioSeleccionadoId is not > 0)
            {
                errorMsg = "No encontramos el grupo familiar para consultar solicitudes.";
                items = [];
                return;
            }

            await CargarSolicitudesAsync(beneficiarioSeleccionadoId.Value);
        }
        catch
        {
            errorMsg = "No se pudo cargar el listado. Intenta de nuevo.";
            items = [];
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarGrupoFamiliarAsync(int? beneficiarioPerfilId)
    {
        grupoFamiliar = [];
        beneficiariosPorId = new Dictionary<int, (string Nombre, string Cedula)>();

        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var cedulaSesion = auth.User.Identity?.Name?.Trim() ?? string.Empty;

            List<BeneficiarioDto>? grupo = null;
            if (!string.IsNullOrWhiteSpace(cedulaSesion))
            {
                var porCedula = await CuidanetService.GetBeneficiariosAsync(cedula: cedulaSesion);
                var primero = porCedula?.FirstOrDefault();
                if (primero is not null)
                    grupo = await CuidanetService.GetBeneficiariosAsync(titularId: primero.TitularId);
            }

            if ((grupo is null || grupo.Count == 0) && beneficiarioPerfilId is > 0)
            {
                var detalle = await CuidanetService.GetBeneficiarioDetalleAsync(beneficiarioPerfilId.Value);
                if (detalle is not null)
                    grupo = await CuidanetService.GetBeneficiariosAsync(titularId: detalle.TitularId);
            }

            grupoFamiliar = (grupo ?? [])
                .OrderBy(b => b.BeneficiarioId == b.TitularId ? 0 : 1)
                .ThenBy(b => b.NombreCompleto, StringComparer.OrdinalIgnoreCase)
                .ToList();

            foreach (var b in grupoFamiliar)
                beneficiariosPorId[b.BeneficiarioId] = (b.NombreCompleto, b.Cedula ?? string.Empty);

            if (beneficiarioSeleccionadoId is null
                || !grupoFamiliar.Any(b => b.BeneficiarioId == beneficiarioSeleccionadoId))
            {
                BeneficiarioDto? elegido = null;
                if (beneficiarioPerfilId is > 0)
                    elegido = grupoFamiliar.FirstOrDefault(b => b.BeneficiarioId == beneficiarioPerfilId.Value);
                elegido ??= grupoFamiliar.FirstOrDefault();
                if (elegido is not null)
                    AplicarAsegurado(elegido);
            }
            else
            {
                var actual = grupoFamiliar.First(b => b.BeneficiarioId == beneficiarioSeleccionadoId);
                AplicarAsegurado(actual);
            }
        }
        catch
        {
            // Sin grupo familiar no bloqueamos del todo; se intenta con el perfil más abajo.
            if (beneficiarioPerfilId is > 0 && beneficiarioSeleccionadoId is null)
            {
                beneficiarioSeleccionadoId = beneficiarioPerfilId;
                textoAseguradoSeleccionado = string.Empty;
            }
        }
    }

    private async Task SeleccionarAseguradoAsync(BeneficiarioDto afiliado)
    {
        if (beneficiarioSeleccionadoId == afiliado.BeneficiarioId && !cargando)
            return;

        AplicarAsegurado(afiliado);
        cargando = true;
        errorMsg = null;
        try
        {
            await CargarSolicitudesAsync(afiliado.BeneficiarioId);
        }
        catch
        {
            errorMsg = "No se pudo cargar el listado. Intenta de nuevo.";
            items = [];
        }
        finally
        {
            cargando = false;
        }
    }

    private void AplicarAsegurado(BeneficiarioDto afiliado)
    {
        beneficiarioSeleccionadoId = afiliado.BeneficiarioId;
        textoAseguradoSeleccionado = afiliado.NombreCompleto;
    }

    private async Task CargarSolicitudesAsync(int beneficiarioId)
    {
        items = await CuidanetService.GetReembolsoSolicitudesAsync(beneficiarioId);
    }

    private string TextoBeneficiario(ReembolsoSolicitudListaDto s)
    {
        var nombre = s.NombreBeneficiario?.Trim();
        var cedula = s.CedulaBeneficiario?.Trim();

        if (string.IsNullOrWhiteSpace(nombre) || string.IsNullOrWhiteSpace(cedula))
        {
            if (beneficiariosPorId.TryGetValue(s.BeneficiarioId, out var info))
            {
                if (string.IsNullOrWhiteSpace(nombre))
                    nombre = info.Nombre;
                if (string.IsNullOrWhiteSpace(cedula))
                    cedula = info.Cedula;
            }
        }

        if (string.IsNullOrWhiteSpace(nombre) && string.IsNullOrWhiteSpace(cedula))
            return string.Empty;

        if (string.IsNullOrWhiteSpace(cedula))
            return nombre!;
        if (string.IsNullOrWhiteSpace(nombre))
            return $"C.I. {cedula}";
        return $"{nombre} · C.I. {cedula}";
    }

    private static string GetInitials(BeneficiarioDto b)
    {
        var n = (b.Nombre ?? string.Empty).Trim();
        var a = (b.Apellido ?? string.Empty).Trim();
        if (n.Length > 0 && a.Length > 0)
            return $"{char.ToUpperInvariant(n[0])}{char.ToUpperInvariant(a[0])}";
        var digits = new string((b.Cedula ?? string.Empty).Where(char.IsDigit).ToArray());
        return digits.Length >= 2 ? digits[^2..] : "?";
    }

    private void Abrir(int id) => Navigation.NavigateTo($"tratamiento/{id}");
    private void NuevaSolicitud() => Navigation.NavigateTo("reembolso");
    private void GoHome() => Navigation.NavigateTo("Home");

    private static string EtiquetaStatus(string? status) => ReembolsoUiLabels.EstadoLista(status);
}

@page "/tratamiento/{SolicitudId:int}"
@layout EmptyLayout
@using System.IO
@using System.Net.Http
@using Cuidanet.Models
@using Cuidanet.Services
@inject NavigationManager Navigation
@inject CuidanetApiClient CuidanetService
@inject CuidanetAppSettings AppSettings
@inject AfiliadoPerfilService PerfilService
@inject IJSRuntime JS

<PageTitle>Cuidanet — Tratamiento</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-lab">
            <div class="cn-lab__shell">
                <PageHeader Title="Detalle de solicitud"
                            Lead="Revisa adjuntos, estado y medicamentos. Si te equivocaste, corrige o anula."
                            Back="GoBack" />

                <section class="cn-lab__sheet">
                    @if (cargando)
                    {
                        <div class="cn-lab__status cn-lab__status--info" role="status">
                            <span class="cn-lab__spinner" aria-hidden="true"></span>
                            <p>Cargando solicitud…</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(errorMsg))
                    {
                        <div class="cn-lab__status cn-lab__status--danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                            <p>@errorMsg</p>
                        </div>
                        <div class="cn-lab__btn-row">
                            <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="CargarAsync" disabled="@cargando">
                                Reintentar
                            </button>
                        </div>
                    }
                    else if (borrador is not null)
                    {
                        <div class="cn-lab__status @StatusToneClass" role="status">
                            <i class="bi @StatusIcon" aria-hidden="true"></i>
                            <p>
                                Solicitud #@borrador.SolicitudId · Tratamiento #@borrador.TratamientoId ·
                                Estado: <strong>@EtiquetaStatus(borrador.Status)</strong>
                            </p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(borrador.UltimoError))
                        {
                            <p class="cn-lab__footnote" style="color:var(--cn-orange);">@borrador.UltimoError</p>
                        }

                        <h3 class="cn-lab__anexo-title" style="margin-top:1rem;">Documentos adjuntos</h3>
                        @if (borrador.Imagenes.Count == 0)
                        {
                            <p class="cn-lab__footnote">No hay adjuntos vinculados a esta solicitud.</p>
                        }
                        else
                        {
                            <div class="cn-lab__anexo-list">
                                @foreach (var img in borrador.Imagenes)
                                {
                                    <div class="cn-lab__anexo">
                                        <div class="cn-lab__anexo-head">
                                            <p class="cn-lab__anexo-title">@EtiquetaTipo(img.TipoAnexo)</p>
                                            <button type="button"
                                                    class="cn-lab__anexo-clear"
                                                    style="color:#0170a0;text-decoration:none;"
                                                    disabled="@ocupado"
                                                    @onclick="() => VerAdjuntoAsync(img.ImagenesId)">
                                                Ver
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (borrador.PuedeEditar && !modoCorregir)
                        {
                            <div class="cn-lab__btn-row" style="margin-top:0.85rem;">
                                <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="IniciarCorreccion" disabled="@ocupado">
                                    Corregir documentos
                                </button>
                                <button type="button" class="cn-lab__btn" @onclick="AnularAsync" disabled="@ocupado">
                                    Anular solicitud
                                </button>
                            </div>
                        }

                        @if (modoCorregir)
                        {
                            <h3 class="cn-lab__anexo-title" style="margin-top:1.25rem;">Corregir y reenviar</h3>
                            <p class="cn-lab__footnote">Se actualiza la misma solicitud #@borrador.SolicitudId (no crea una nueva) y se vuelve a procesar.</p>
                            <div class="cn-lab__anexo-list">
                                @foreach (var anexo in anexosCorreccion)
                                {
                                    <div class="cn-lab__anexo">
                                        <div class="cn-lab__anexo-head">
                                            <p class="cn-lab__anexo-title">@anexo.Etiqueta</p>
                                            <div class="cn-lab__anexo-actions">
                                                @if (!string.IsNullOrEmpty(anexo.FileName))
                                                {
                                                    <span class="cn-lab__anexo-badge">Listo</span>
                                                    <button type="button" class="cn-lab__anexo-clear" @onclick="() => anexo.Clear()" disabled="@ocupado">Quitar</button>
                                                }
                                            </div>
                                        </div>
                                        <label class="cn-lab__drop-area" style="min-height:auto;padding:0.85rem;">
                                            <InputFile @key="anexo.InputKey"
                                                       OnChange="e => OnCorreccionSelected(e, anexo)"
                                                       class="cn-lab__file-input"
                                                       accept="image/png,image/jpeg,application/pdf"
                                                       disabled="@ocupado" />
                                            <span class="cn-lab__drop-title" style="font-size:0.85rem;">
                                                @(string.IsNullOrEmpty(anexo.FileName) ? "Toca para elegir archivo" : anexo.FileName)
                                            </span>
                                        </label>
                                        @if (!string.IsNullOrWhiteSpace(anexo.PreviewDataUrl)
                                             && !anexo.PreviewDataUrl.StartsWith("data:application/pdf", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <img class="cn-lab__preview" src="@anexo.PreviewDataUrl" alt="Vista previa" style="margin-top:0.5rem;" />
                                        }
                                    </div>
                                }
                            </div>
                            <div class="cn-lab__btn-row">
                                <button type="button" class="cn-lab__btn" @onclick="() => modoCorregir = false" disabled="@ocupado">Cancelar</button>
                                <button type="button" class="cn-lab__btn cn-lab__btn--primary"
                                        disabled="@(ocupado || !anexosCorreccion.Any(a => a.Bytes is { Length: > 0 }))"
                                        @onclick="GuardarCorreccionAsync">
                                    @if (ocupado)
                                    {
                                        <span class="cn-lab__spinner" aria-hidden="true"></span>
                                        <span>Guardando…</span>
                                    }
                                    else
                                    {
                                        <span>Guardar corrección</span>
                                    }
                                </button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(statusMessage))
                        {
                            <div class="cn-lab__status @StatusMsgClass" role="status" style="margin-top:0.85rem;">
                                <i class="bi @StatusMsgIcon" aria-hidden="true"></i>
                                <p>@statusMessage</p>
                            </div>
                        }

                        <div class="cn-lab__field" style="margin-top:1rem;">
                            <p class="cn-lab__label">Médico</p>
                            <p>@(string.IsNullOrWhiteSpace(borrador.NombreMedico) ? "—" : borrador.NombreMedico)</p>
                        </div>
                        <div class="cn-lab__field">
                            <p class="cn-lab__label">Fecha récipe</p>
                            <p>@(borrador.FechaRecipe?.ToString("dd/MM/yyyy") ?? "—")</p>
                        </div>

                        @if (borrador.Extraccion is not null)
                        {
                            <div class="cn-lab__field">
                                <p class="cn-lab__label">Confianza IA</p>
                                <p>@(borrador.Extraccion.Confianza ?? "—")
                                    @if (!borrador.Extraccion.EncabezadoAplicado && !string.IsNullOrWhiteSpace(borrador.Extraccion.MotivoSinEncabezado))
                                    {
                                        <span class="cn-lab__footnote"> · @borrador.Extraccion.MotivoSinEncabezado</span>
                                    }
                                </p>
                            </div>
                        }

                        <h3 class="cn-lab__anexo-title" style="margin-top:1rem;">Medicamentos en catálogo</h3>
                        @if (borrador.Detalle.Count == 0)
                        {
                            <p class="cn-lab__footnote">Aún no hay líneas vinculadas (pendiente de IA o sin match exacto).</p>
                        }
                        else
                        {
                            <ul class="cn-lab__anexo-list" style="list-style:none;padding:0;margin:0.5rem 0 0;">
                                @foreach (var d in borrador.Detalle)
                                {
                                    <li class="cn-lab__anexo" style="margin-bottom:0.5rem;">
                                        <p class="cn-lab__anexo-title">@(d.NombreMedicamento ?? $"#{d.MedicamentoId}")</p>
                                        <p class="cn-lab__footnote">
                                            Cant. @(d.Cantidad?.ToString("0.##") ?? "—")
                                            @if (!string.IsNullOrWhiteSpace(d.Presentacion))
                                            {
                                                <span> · @d.Presentacion</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(d.Posologia))
                                            {
                                                <span> · @d.Posologia</span>
                                            }
                                        </p>
                                    </li>
                                }
                            </ul>
                        }

                        @if (borrador.Extraccion?.Unmatched is { Count: > 0 })
                        {
                            <h3 class="cn-lab__anexo-title" style="margin-top:1rem;">No catalogados (omitidos)</h3>
                            <ul class="cn-lab__footnote" style="margin:0.35rem 0 0;padding-left:1.1rem;">
                                @foreach (var u in borrador.Extraccion.Unmatched)
                                {
                                    <li>@u.NombreExtraido — @u.Motivo</li>
                                }
                            </ul>
                        }

                        @if (borrador.Extraccion?.Advertencias is { Count: > 0 })
                        {
                            <h3 class="cn-lab__anexo-title" style="margin-top:1rem;">Advertencias</h3>
                            <ul class="cn-lab__footnote" style="margin:0.35rem 0 0;padding-left:1.1rem;">
                                @foreach (var a in borrador.Extraccion.Advertencias)
                                {
                                    <li>@a</li>
                                }
                            </ul>
                        }

                        <div class="cn-lab__btn-row" style="margin-top:1.25rem;">
                            @if (EsProcesando(borrador.Status))
                            {
                                <button type="button" class="cn-lab__btn cn-lab__btn--primary" @onclick="CargarAsync" disabled="@cargando">
                                    Actualizar estado
                                </button>
                            }
                            <button type="button" class="cn-lab__btn" @onclick="IrMisSolicitudes">Mis solicitudes</button>
                            <button type="button" class="cn-lab__btn" @onclick="GoHome">Volver al inicio</button>
                        </div>
                    }
                </section>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public int SolicitudId { get; set; }

    private bool cargando = true;
    private bool ocupado;
    private bool modoCorregir;
    private string? errorMsg;
    private string statusMessage = string.Empty;
    private string statusTone = "info";
    private ReembolsoBorradorResponse? borrador;

    private readonly List<ReembolsoAnexoVm> anexosCorreccion =
    [
        new() { Tipo = "recipe", Etiqueta = "Récipe médico" },
        new() { Tipo = "indicaciones", Etiqueta = "Indicaciones" },
        new() { Tipo = "informe", Etiqueta = "Informe médico" },
    ];

    private long MaxFileSizeBytes => AppSettings.MaxUploadBytes;
    private const string Carpeta = "Reembolsos";
    private const string Campo = "ReembolsoApp";

    protected override async Task OnParametersSetAsync()
    {
        modoCorregir = false;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        errorMsg = null;
        try
        {
            borrador = await CuidanetService.GetReembolsoBorradorAsync(SolicitudId);
            if (borrador is null)
                errorMsg = "No encontramos esa solicitud.";
        }
        catch
        {
            errorMsg = "No se pudo cargar la solicitud. Intenta de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void IniciarCorreccion()
    {
        foreach (var a in anexosCorreccion)
            a.Clear();
        modoCorregir = true;
        statusMessage = string.Empty;
    }

    private async Task OnCorreccionSelected(InputFileChangeEventArgs e, ReembolsoAnexoVm anexo)
    {
        try
        {
            var file = e.File;
            if (file is null) return;
            if (file.Size > MaxFileSizeBytes)
            {
                statusTone = "danger";
                statusMessage = $"El archivo excede {AppSettings.MaxUploadMb} MB.";
                return;
            }

            await using var stream = file.OpenReadStream(MaxFileSizeBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var bytes = memory.ToArray();

            if (!UploadFileGuard.TryValidate(
                    file.Name, bytes, MaxFileSizeBytes, AppSettings.MaxUploadMb,
                    out var safeName, out var validationError))
            {
                statusTone = "danger";
                statusMessage = validationError ?? "Archivo no permitido.";
                return;
            }

            anexo.FileName = safeName;
            anexo.Bytes = bytes;
            anexo.ContentType = GuessMime(safeName);
            anexo.PreviewDataUrl = bytes.Length > 2 * 1024 * 1024
                ? null
                : $"data:{GuessMime(safeName)};base64,{Convert.ToBase64String(bytes)}";
            statusTone = "success";
            statusMessage = $"«{safeName}» listo para {anexo.Etiqueta}.";
        }
        catch
        {
            statusTone = "danger";
            statusMessage = "No se pudo leer el archivo.";
        }
    }

    private async Task GuardarCorreccionAsync()
    {
        if (borrador is null) return;
        var conBytes = anexosCorreccion.Where(a => a.Bytes is { Length: > 0 }).ToList();
        if (conBytes.Count == 0)
        {
            statusTone = "warning";
            statusMessage = "Adjunta al menos un documento corregido.";
            return;
        }

        try
        {
            ocupado = true;
            statusTone = "info";
            statusMessage = "Subiendo corrección…";
            StateHasChanged();

            var perfil = await PerfilService.GetAsync();
            var imagenes = new List<ReembolsoSolicitudImagenDto>();
            foreach (var anexo in conBytes)
            {
                using var memory = new MemoryStream(anexo.Bytes!);
                var upload = await CuidanetService.UploadImagenAsync(
                    fileStream: memory,
                    fileName: anexo.FileName!,
                    carpeta: Carpeta,
                    fuente: AppSettings.ImagenFuente,
                    campo: Campo,
                    beneficiarioId: perfil.BeneficiarioId,
                    observaciones: borrador.Comentario);
                if (upload is null)
                    throw new HttpRequestException($"No se pudo subir «{anexo.Etiqueta}».");
                imagenes.Add(new ReembolsoSolicitudImagenDto
                {
                    ImagenesId = upload.ImagenesId,
                    TipoAnexo = anexo.Tipo
                });
            }

            await CuidanetService.ReemplazarReembolsoImagenesAsync(
                borrador.SolicitudId,
                new ReembolsoReemplazarImagenesRequest { Imagenes = imagenes });

            modoCorregir = false;
            statusTone = "success";
            statusMessage = "Documentos actualizados en la misma solicitud. Se volverá a procesar.";
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            statusTone = "danger";
            statusMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? "No se pudo guardar la corrección."
                : ex.Message;
        }
        catch
        {
            statusTone = "danger";
            statusMessage = "No se pudo guardar la corrección.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task AnularAsync()
    {
        if (borrador is null) return;
        try
        {
            ocupado = true;
            var result = await CuidanetService.AnularReembolsoSolicitudAsync(borrador.SolicitudId);
            statusTone = "success";
            statusMessage = result?.Mensaje ?? "Solicitud anulada.";
            modoCorregir = false;
            await CargarAsync();
        }
        catch (HttpRequestException ex)
        {
            statusTone = "danger";
            statusMessage = string.IsNullOrWhiteSpace(ex.Message) ? "No se pudo anular." : ex.Message;
        }
        catch
        {
            statusTone = "danger";
            statusMessage = "No se pudo anular la solicitud.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task VerAdjuntoAsync(int imagenesId)
    {
        try
        {
            ocupado = true;
            var file = await CuidanetService.DownloadImagenContenidoAsync(imagenesId);
            if (file is null)
            {
                statusTone = "danger";
                statusMessage = "No se encontró el documento.";
                return;
            }

            var ok = await JS.InvokeAsync<bool>("CuidanetUi.openBytes", file.Value.Bytes, file.Value.ContentType);
            if (!ok)
            {
                statusTone = "warning";
                statusMessage = "Permite ventanas emergentes para ver el documento.";
            }
        }
        catch
        {
            statusTone = "danger";
            statusMessage = "No se pudo abrir el documento.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("mis-solicitudes");
    private void GoHome() => Navigation.NavigateTo("");
    private void IrMisSolicitudes() => Navigation.NavigateTo("mis-solicitudes");

    private static bool EsProcesando(string? status) =>
        string.Equals(status, "Pendiente", StringComparison.OrdinalIgnoreCase)
        || string.Equals(status, "Procesando", StringComparison.OrdinalIgnoreCase);

    private static string EtiquetaStatus(string? status) => status switch
    {
        "Pendiente" => "En cola",
        "Procesando" => "Analizando documentos",
        "Listo" => "Procesado",
        "Error" => "Error",
        "Anulado" => "Anulada",
        _ => status ?? "—"
    };

    private static string EtiquetaTipo(string? tipo) => tipo?.Trim().ToLowerInvariant() switch
    {
        "recipe" or "récipe" or "recipe médico" => "Récipe médico",
        "indicaciones" => "Indicaciones",
        "informe" or "informe médico" => "Informe médico",
        _ => string.IsNullOrWhiteSpace(tipo) ? "Documento" : tipo
    };

    private static string GuessMime(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".pdf" => "application/pdf",
            _ => "application/octet-stream"
        };
    }

    private string StatusToneClass => borrador?.Status switch
    {
        "Listo" => "cn-lab__status--success",
        "Error" => "cn-lab__status--danger",
        "Anulado" => "cn-lab__status--warning",
        "Procesando" => "cn-lab__status--warning",
        _ => "cn-lab__status--info"
    };

    private string StatusIcon => borrador?.Status switch
    {
        "Listo" => "bi-check-circle-fill",
        "Error" => "bi-x-circle-fill",
        "Anulado" => "bi-slash-circle",
        "Procesando" => "bi-hourglass-split",
        _ => "bi-info-circle-fill"
    };

    private string StatusMsgClass => statusTone switch
    {
        "success" => "cn-lab__status--success",
        "warning" => "cn-lab__status--warning",
        "danger" => "cn-lab__status--danger",
        _ => "cn-lab__status--info"
    };

    private string StatusMsgIcon => statusTone switch
    {
        "success" => "bi-check-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "danger" => "bi-x-circle-fill",
        _ => "bi-info-circle-fill"
    };
}

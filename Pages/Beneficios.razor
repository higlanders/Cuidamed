@page "/Beneficios"
@layout FrameWork
@using Cuidanet.Services
@using Cuidanet.Models
@inject CuidanetApiClient CuidanetService

<div class="container-fluid py-2 px-1">

    <!-- Encabezado de Sección -->
    <div class="d-flex align-items-center justify-content-between mb-3 px-2">
        <div>
            <h5 class="fw-bold text-info-custom mb-0">Mis Beneficios</h5>
            <p class="text-muted small mb-0">Consulta tus coberturas y montos disponibles</p>
        </div>
        <span class="badge bg-light text-dark border p-2">
            📋 Plan Activo
        </span>
    </div>

    @if (cargando)
    {
        <!-- Estado de Carga -->
        <div class="text-center py-5">
            <div class="spinner-border text-info-custom" role="status">
                <span class="visually-hidden">Cargando coberturas...</span>
            </div>
            <p class="text-muted small mt-2">Consultando coberturas vigentes...</p>
        </div>
    }
    else if (coberturas == null || !coberturas.Any())
    {
        <!-- Estado Vacío -->
        <div class="alert alert-light text-center border rounded-3 p-4 shadow-sm">
            <span style="font-size: 2.5rem;">📂</span>
            <h6 class="fw-bold mt-2 text-secondary">Sin coberturas registradas</h6>
            <p class="text-muted small mb-0">No se encontraron beneficios o coberturas vigentes asociadas a tu cuenta.</p>
        </div>
    }
    else
    {
        <!-- Resumen General / KPI -->
        <div class="card card-resumen border-0 shadow-sm mb-4 text-white">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-uppercase small opacity-75 fw-semibold">Total Coberturas</span>
                        <h3 class="fw-bold mb-0">@coberturas.Count</h3>
                    </div>
                    <div class="icon-circle bg-white text-info-custom">
                        🛡️
                    </div>
                </div>
            </div>
        </div>

        <!-- Lista de Beneficios / Coberturas -->
        <div class="row g-3">
            @foreach (var item in coberturas)
            {
                <div class="col-12 col-md-6">
                    <div class="card border-0 shadow-sm h-100 card-beneficio">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold text-dark mb-0">@item.NombreServicio</h6>
                                <span class="badge @(item.EstaVigente ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger") rounded-pill px-2">
                                    @(item.EstaVigente ? "Vigente" : "Agotado / Inactivo")
                                </span>
                            </div>

                            <p class="text-muted small mb-3">@item.Descripcion</p>

                            <!-- Barra de Progreso de Consumo -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Consumido: <strong>$@item.MontoConsumido.ToString("N2")</strong></span>
                                    <span class="fw-bold text-info-custom">Límite: $@item.MontoLimite.ToString("N2")</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar @ObtenerColorBarra(item.PorcentajeConsumido)"
                                         role="progressbar"
                                         style="width: @(item.PorcentajeConsumido)%"
                                         aria-valuenow="@item.PorcentajeConsumido"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-3">
                                <span class="text-muted extra-small">Disponible:</span>
                                <span class="fw-bold text-success fs-6">$@((item.MontoLimite - item.MontoConsumido).ToString("N2"))</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .text-info-custom {
        color: #00a4ba !important; /* */
    }

    .card-resumen {
        background: linear-gradient(135deg, #00a4ba 0%, #007a8a 100%);
        border-radius: 14px;
    }

    .icon-circle {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .card-beneficio {
        border-radius: 12px;
        border: 1px solid #f0f0f0 !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-beneficio:active {
            transform: scale(0.99);
        }

    .extra-small {
        font-size: 0.75rem;
    }
</style>

@code {
    private bool cargando = true;
    private List<CoberturaDto> coberturas = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Simulación o llamada al API de Cuidanet
            //coberturas = await CuidanetService.GetCoberturasVigentesAsync() ?? new();
            coberturas = new();
        }
        catch (Exception)
        {
            // Manejo silencioso o logger
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerColorBarra(decimal porcentaje)
    {
        if (porcentaje >= 90) return "bg-danger";
        if (porcentaje >= 70) return "bg-warning";
        return "bg-info-custom-bar";
    }

    // DTO de soporte interno para la vista si no existe en la biblioteca
    public class CoberturaDto
    {
        public string NombreServicio { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public decimal MontoLimite { get; set; }
        public decimal MontoConsumido { get; set; }
        public bool EstaVigente { get; set; } = true;
        public decimal PorcentajeConsumido => MontoLimite > 0 ? (MontoConsumido / MontoLimite) * 100 : 0;
    }
}
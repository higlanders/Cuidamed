@page "/Citas-aps"
@layout EmptyLayout
@using Cuidanet.Services
@inject NavigationManager Navigation
@inject LisRouteGuard LisGuard
@inject BrandProfile Brand

<PageTitle>@Brand.Title("Solicitar cita")</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="cn-svc">
            <div class="cn-svc__shell">
                <PageHeader Title="Solicitar cita"
                            Lead="@Lead"
                            Back="GoHome" />

                <section class="cn-svc__sheet">
                    @if (enviada)
                    {
                        <article class="cn-svc__card">
                            <p class="cn-svc__muted" style="margin:0 0 0.2rem;">Servicio</p>
                            <p style="margin:0 0 0.85rem;font-weight:600;">@TextoServicio</p>

                            @if (EsConsulta)
                            {
                                <p class="cn-svc__muted" style="margin:0 0 0.2rem;">Especialidad</p>
                                <p style="margin:0 0 0.85rem;font-weight:600;">@especialidad</p>
                            }

                            <p class="cn-svc__muted" style="margin:0 0 0.2rem;">Día sugerido</p>
                            <p style="margin:0 0 0.85rem;font-weight:600;">@diaSemana · @turno</p>

                            <p class="cn-svc__muted" style="margin:0 0 0.2rem;">Día específico</p>
                            <p style="margin:0;font-weight:600;">@(TextoFechaEspecifica ?? "No indicado")</p>
                        </article>

                        <button type="button" class="cn-svc__cta" @onclick="Reiniciar">
                            Solicitar otra
                        </button>
                    }
                    else
                    {
                        <div class="cn-svc__field">
                            <label class="cn-svc__label" for="tipo-servicio">Tipo de servicio</label>
                            <select id="tipo-servicio" class="cn-svc__input" @bind="tipoServicio" @bind:after="AlCambiarTipo">
                                <option value="">Seleccionar</option>
                                @foreach (var tipo in TiposServicio)
                                {
                                    <option value="@tipo">@tipo</option>
                                }
                            </select>
                        </div>

                        @if (EsConsulta)
                        {
                            <div class="cn-svc__field">
                                <label class="cn-svc__label" for="especialidad">Especialidad</label>
                                <select id="especialidad" class="cn-svc__input" @bind="especialidad">
                                    <option value="">Seleccionar</option>
                                    @foreach (var item in Especialidades)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="cn-svc__field">
                            <label class="cn-svc__label" for="dia-semana">Día de la semana</label>
                            <select id="dia-semana" class="cn-svc__input" @bind="diaSemana">
                                <option value="">Seleccionar</option>
                                @foreach (var dia in DiasSemana)
                                {
                                    <option value="@dia">@dia</option>
                                }
                            </select>
                        </div>

                        <div class="cn-svc__field">
                            <label class="cn-svc__label" for="turno">Turno</label>
                            <select id="turno" class="cn-svc__input" @bind="turno">
                                <option value="">Seleccionar</option>
                                <option value="Mañana">Mañana</option>
                                <option value="Tarde">Tarde</option>
                            </select>
                        </div>

                        <div class="cn-svc__field">
                            <label class="cn-svc__label" for="fecha-especifica">Día específico (opcional)</label>
                            <input id="fecha-especifica"
                                   type="date"
                                   class="cn-svc__input"
                                   min="@MinFecha"
                                   @bind="fechaEspecifica" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <p class="cn-svc__error" role="alert">@errorMessage</p>
                        }

                        <button type="button" class="cn-svc__cta" @onclick="Continuar">
                            Continuar
                        </button>
                    }
                </section>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly string[] TiposServicio = ["Consulta", "Laboratorio", "Imágenes", "Estudios"];

    private static readonly string[] Especialidades =
    [
        "Medicina general / familiar",
        "Pediatría",
        "Medicina interna",
        "Ginecología"
    ];

    private static readonly string[] DiasSemana =
    [
        "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"
    ];

    private string tipoServicio = string.Empty;
    private string especialidad = string.Empty;
    private string diaSemana = string.Empty;
    private string turno = string.Empty;
    private DateOnly? fechaEspecifica;
    private string errorMessage = string.Empty;
    private bool enviada;

    private bool EsConsulta =>
        string.Equals(tipoServicio, "Consulta", StringComparison.OrdinalIgnoreCase);

    private string Lead => enviada
        ? "Así quedó la preferencia de tu cita."
        : "Elige el servicio y sugiere el día y el turno que prefieres.";

    private DateOnly MinFecha => DateOnly.FromDateTime(DateTime.Today);

    private string TextoServicio => tipoServicio;

    private string? TextoFechaEspecifica => fechaEspecifica?.ToString("dd/MM/yyyy");

    protected override async Task OnInitializedAsync()
    {
        await LisGuard.EnsureAllowedAsync();
    }

    private void GoHome() => Navigation.NavigateTo("Home");

    private void AlCambiarTipo()
    {
        if (!EsConsulta)
            especialidad = string.Empty;

        errorMessage = string.Empty;
    }

    private void Continuar()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(tipoServicio))
        {
            errorMessage = "Elige el tipo de servicio.";
            return;
        }

        if (EsConsulta && string.IsNullOrWhiteSpace(especialidad))
        {
            errorMessage = "Elige la especialidad.";
            return;
        }

        if (string.IsNullOrWhiteSpace(diaSemana))
        {
            errorMessage = "Elige un día de la semana.";
            return;
        }

        if (turno is not ("Mañana" or "Tarde"))
        {
            errorMessage = "Indica si prefieres la mañana o la tarde.";
            return;
        }

        if (fechaEspecifica is DateOnly fecha && fecha < MinFecha)
        {
            errorMessage = "El día específico no puede ser anterior a hoy.";
            return;
        }

        enviada = true;
    }

    private void Reiniciar()
    {
        tipoServicio = string.Empty;
        especialidad = string.Empty;
        diaSemana = string.Empty;
        turno = string.Empty;
        fechaEspecifica = null;
        errorMessage = string.Empty;
        enviada = false;
    }
}

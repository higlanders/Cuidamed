<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.8" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!--
    .NET 10 + ServiceWorkerAssetsManifest duplica assets cuyo nombre tiene varios puntos
    (appsettings.json / appsettings.Development.json / appsettings.example.json).
    Los sacamos del pipeline SWA y los copiamos a mano a output/publish.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\appsettings*.json" />
  </ItemGroup>

  <Target Name="CopyAppsettingsToOutput" AfterTargets="Build">
    <Copy SourceFiles="wwwroot\appsettings.json"
          DestinationFolder="$(OutputPath)wwwroot"
          SkipUnchangedFiles="true"
          Condition="Exists('wwwroot\appsettings.json')" />
    <Copy SourceFiles="wwwroot\appsettings.Development.json"
          DestinationFolder="$(OutputPath)wwwroot"
          SkipUnchangedFiles="true"
          Condition="Exists('wwwroot\appsettings.Development.json')" />
  </Target>

  <Target Name="CopyAppsettingsToPublish" AfterTargets="Publish">
    <Copy SourceFiles="wwwroot\appsettings.json"
          DestinationFolder="$(PublishDir)wwwroot"
          SkipUnchangedFiles="true"
          Condition="Exists('wwwroot\appsettings.json')" />
  </Target>

</Project>

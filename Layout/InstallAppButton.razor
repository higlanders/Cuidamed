@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_eligible)
{
    @if (Variant == InstallVariant.SoftPrompt && _showSoftPrompt)
    {
        <div class="cn-install-tip" role="region" aria-label="Instalar aplicación">
            @if (_showManualHelp)
            {
                <div class="cn-install-tip__help">
                    <p class="cn-install-tip__title">Cómo instalar</p>
                    @if (_isIos)
                    {
                        <ol class="cn-install-tip__steps">
                            <li>Toca <strong>Compartir</strong> en Safari.</li>
                            <li>Elige <strong>Añadir a pantalla de inicio</strong>.</li>
                            <li>Confirma con <strong>Añadir</strong>.</li>
                        </ol>
                    }
                    else
                    {
                        <p class="cn-install-tip__text">En el menú del navegador (⋮) elige <strong>Instalar aplicación</strong>.</p>
                    }
                    <button type="button" class="cn-install-tip__link" @onclick="CerrarAyuda">Cerrar</button>
                </div>
            }
            else
            {
                <div class="cn-install-tip__row">
                    <div class="cn-install-tip__copy">
                        <p class="cn-install-tip__title">Acceso más rápido</p>
                        <p class="cn-install-tip__text">Instala Cuidanet en tu dispositivo.</p>
                    </div>
                    <button type="button" class="cn-install-tip__dismiss" @onclick="DismissSoftPromptAsync" aria-label="Cerrar">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="cn-install-tip__actions">
                    <button type="button" class="cn-install-tip__secondary" @onclick="DismissSoftPromptAsync">Ahora no</button>
                    <button type="button" class="cn-install-tip__primary" @onclick="OnInstalarClick">Instalar</button>
                </div>
            }
        </div>
    }
    else if (Variant == InstallVariant.MenuItem)
    {
        <button type="button" class="cn-install-menu" @onclick="OnInstalarClick">
            <i class="bi bi-download" aria-hidden="true"></i>
            Instalar aplicación
        </button>

        @if (_showManualHelp)
        {
            <div class="cn-install-tip cn-install-tip--drawer" role="dialog" aria-label="Cómo instalar">
                @if (_isIos)
                {
                    <ol class="cn-install-tip__steps">
                        <li>Toca <strong>Compartir</strong> en Safari.</li>
                        <li>Elige <strong>Añadir a pantalla de inicio</strong>.</li>
                        <li>Confirma con <strong>Añadir</strong>.</li>
                    </ol>
                }
                else
                {
                    <p class="cn-install-tip__text">En el menú del navegador (⋮) elige <strong>Instalar aplicación</strong>.</p>
                }
                <button type="button" class="cn-install-tip__link" @onclick="CerrarAyuda">Entendido</button>
            </div>
        }
    }
}

@code {
    public enum InstallVariant
    {
        SoftPrompt,
        MenuItem
    }

    [Parameter] public InstallVariant Variant { get; set; } = InstallVariant.SoftPrompt;

    private bool _eligible;
    private bool _showSoftPrompt;
    private bool _showManualHelp;
    private bool _isIos;
    private DotNetObjectReference<InstallAppButton>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("cuidanetPwa.bind", _dotNetRef);
            await RefreshStateAsync();
        }
        catch
        {
            _eligible = false;
        }
    }

    private async Task RefreshStateAsync()
    {
        try
        {
            ApplyState(await JS.InvokeAsync<PwaInstallState>("cuidanetPwa.getState"));
        }
        catch
        {
            _eligible = false;
            _showSoftPrompt = false;
        }
    }

    private void ApplyState(PwaInstallState? state)
    {
        if (state is null || state.Installed)
        {
            _eligible = false;
            _showSoftPrompt = false;
            StateHasChanged();
            return;
        }

        _isIos = state.IsIos;
        _eligible = true;
        // Soft prompt solo si no lo descartaron; el ítem de menú siempre si no está instalada.
        _showSoftPrompt = Variant == InstallVariant.SoftPrompt && !state.Dismissed;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPwaStateChanged(PwaInstallState state) => ApplyState(state);

    private async Task OnInstalarClick()
    {
        try
        {
            var result = await JS.InvokeAsync<PwaInstallResult>("cuidanetPwa.install");
            if (result is null) return;

            if (string.Equals(result.Mode, "native", StringComparison.OrdinalIgnoreCase)
                && string.Equals(result.Outcome, "accepted", StringComparison.OrdinalIgnoreCase))
            {
                _eligible = false;
                _showSoftPrompt = false;
                _showManualHelp = false;
                StateHasChanged();
                return;
            }

            _showManualHelp = true;
            StateHasChanged();
        }
        catch
        {
            _showManualHelp = true;
            StateHasChanged();
        }
    }

    private async Task DismissSoftPromptAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("cuidanetPwa.dismiss", 14);
        }
        catch
        {
            // ignore
        }

        _showSoftPrompt = false;
        _showManualHelp = false;
        StateHasChanged();
    }

    private void CerrarAyuda() => _showManualHelp = false;

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("cuidanetPwa.unbind", _dotNetRef);
        }
        catch
        {
            // ignore
        }

        _dotNetRef?.Dispose();
    }

    public sealed class PwaInstallState
    {
        public bool Installed { get; set; }
        public bool CanPrompt { get; set; }
        public bool IsIos { get; set; }
        public bool Dismissed { get; set; }
    }

    public sealed class PwaInstallResult
    {
        public string? Outcome { get; set; }
        public string? Mode { get; set; }
    }
}
